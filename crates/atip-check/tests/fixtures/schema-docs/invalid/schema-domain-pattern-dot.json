{
  "ok": true,
  "data": {
    "kind": "command",
    "command": "member tag",
    "path": [
      "member",
      "tag"
    ],
    "summary": "Add a tag to a member",
    "effect": "write",
    "idempotency": "replay-safe",
    "operands": [
      {
        "name": "number",
        "valueName": "NUMBER",
        "valueType": "integer",
        "required": true,
        "variadic": false,
        "default": null,
        "help": "The member's number"
      }
    ],
    "options": [
      {
        "name": "tag",
        "valueName": "TAG",
        "valueType": "string",
        "required": true,
        "repeatable": false,
        "default": null,
        "domain": {
          "pattern": "^.+$"
        },
        "help": "The tag to add"
      },
      {
        "name": "input",
        "valueName": "JSON|FILE|-",
        "valueType": "string",
        "required": false,
        "repeatable": false,
        "default": null,
        "flagOnly": true,
        "help": "The arguments as JSON: one object, or an array for a batch"
      },
      {
        "name": "by",
        "valueName": "EMAIL",
        "valueType": "string",
        "required": false,
        "repeatable": false,
        "default": null,
        "domain": {
          "format": "email",
          "maxLength": 254
        },
        "help": "Who adds the tag, an email address (recorded, not checked)"
      },
      {
        "name": "json",
        "valueType": "switch",
        "required": false,
        "repeatable": false,
        "default": false,
        "flagOnly": true,
        "help": "Output JSON instead of the human-readable form"
      }
    ],
    "errors": [
      "BATCH_INCOMPLETE",
      "INPUT_CONFLICT",
      "INPUT_INVALID",
      "INPUT_TOO_LARGE",
      "INTERNAL",
      "MEMBER_NOT_FOUND",
      "USAGE"
    ],
    "outputs": [
      {
        "kind": "report",
        "schemaRef": "#/schemas/MemberTagReport",
        "schemaVersion": "1.0"
      },
      {
        "kind": "report",
        "schemaRef": "#/schemas/BatchMemberTagReport",
        "schemaVersion": "1.0",
        "batch": true,
        "when": "--input is an array"
      }
    ],
    "input": {
      "option": "--input",
      "schemaRef": "#/schemas/MemberTagInput",
      "argumentsRef": "#/schemas/MemberTagArguments",
      "batch": true,
      "maxBytes": 65536,
      "maxItems": 100,
      "example": {
        "operands": [
          7
        ],
        "tag": "core"
      }
    },
    "examples": [
      "acme member tag 7 --tag core --json",
      "acme member tag --input '[{\"operands\":[7],\"tag\":\"core\"},{\"operands\":[\"8\"],\"tag\":\"lead\"}]' --json"
    ],
    "schemas": {
      "MemberTagReport": {
        "type": "object",
        "required": [
          "number",
          "tags",
          "unchanged"
        ],
        "properties": {
          "number": {
            "type": "integer"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unchanged": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "BatchMemberTagReport": {
        "type": "object",
        "description": "Deliberately permissive: spec 11.11 makes the generic batch-report schema apply whatever this says."
      },
      "MemberTagInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operands": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "string"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            "minItems": 1,
            "maxItems": 1
          },
          "tag": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "maxLength": 254
          }
        }
      },
      "MemberTagArguments": {
        "description": "The argument object (spec 11.7 step 6): numbers are numbers here, whatever their spelling in the document.",
        "type": "object",
        "required": [
          "operands",
          "tag"
        ],
        "additionalProperties": false,
        "properties": {
          "operands": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "maxItems": 1
          },
          "tag": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    }
  },
  "meta": {
    "command": "schema",
    "contract": "atip/1",
    "contractVersion": "1.1",
    "schemaVersion": "1.1",
    "tool": "acme",
    "toolVersion": "1.0.0"
  }
}
