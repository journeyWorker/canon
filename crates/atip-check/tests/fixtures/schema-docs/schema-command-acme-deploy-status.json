{
  "ok": true,
  "data": {
    "kind": "command",
    "command": "deploy status",
    "path": [
      "deploy",
      "status"
    ],
    "summary": "Show a deployment's state, or wait until it ends",
    "effect": "read",
    "operands": [
      {
        "name": "deployment",
        "valueName": "DEPLOYMENT",
        "valueType": "string",
        "required": true,
        "variadic": false,
        "default": null,
        "help": "The deployment, as deploy start reported it"
      }
    ],
    "options": [
      {
        "name": "wait",
        "valueType": "switch",
        "required": false,
        "repeatable": false,
        "default": false,
        "help": "Wait until the deployment ends"
      },
      {
        "name": "timeout",
        "valueName": "DURATION",
        "valueType": "string",
        "required": false,
        "repeatable": false,
        "default": "10m",
        "help": "How long --wait waits (90s, 10m, 1h30m)"
      },
      {
        "name": "json",
        "valueType": "switch",
        "required": false,
        "repeatable": false,
        "default": false,
        "flagOnly": true,
        "help": "Output JSON instead of the human-readable form"
      }
    ],
    "errors": [
      "DEPLOYMENT_NOT_FOUND",
      "DEPLOY_FAILED",
      "DEPLOY_WAIT_TIMEOUT",
      "INTERNAL",
      "USAGE"
    ],
    "outputs": [
      {
        "kind": "report",
        "schemaRef": "#/schemas/DeployStatus",
        "schemaVersion": "1.0"
      }
    ],
    "examples": [
      "acme deploy status d-7f3a --json",
      "acme deploy status d-7f3a --wait --timeout 10m --json"
    ],
    "schemas": {
      "DeployStatus": {
        "type": "object",
        "required": [
          "deployment",
          "environment",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "deployment": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "state": {
            "enum": [
              "accepted",
              "running",
              "done",
              "failed"
            ]
          }
        }
      }
    }
  },
  "meta": {
    "command": "schema",
    "contract": "atip/1",
    "contractVersion": "1.1",
    "schemaVersion": "1.1",
    "tool": "acme",
    "toolVersion": "1.0.0"
  }
}
