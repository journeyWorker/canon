{
  "ok": true,
  "data": {
    "kind": "command",
    "command": "member show",
    "path": [
      "member",
      "show"
    ],
    "summary": "Show one member by number",
    "effect": "read",
    "operands": [
      {
        "name": "number",
        "valueName": "NUMBER",
        "valueType": "integer",
        "required": true,
        "variadic": false,
        "default": null,
        "help": "The member's number"
      }
    ],
    "options": [
      {
        "name": "json",
        "valueType": "switch",
        "required": false,
        "repeatable": false,
        "default": false,
        "flagOnly": true,
        "help": "Output JSON instead of the human-readable form"
      }
    ],
    "errors": [
      "INTERNAL",
      "MEMBER_NOT_FOUND",
      "USAGE"
    ],
    "outputs": [
      {
        "kind": "report",
        "schemaRef": "#/schemas/MemberShowReport",
        "schemaVersion": "1.0"
      }
    ],
    "examples": [
      "acme member show 7 --json",
      "acme member show --json -- 7",
      "acme member show 9007199254740991 --json",
      "acme member show --json -- -9007199254740991"
    ],
    "schemas": {
      "MemberShowReport": {
        "type": "object",
        "required": [
          "member"
        ],
        "properties": {
          "member": {
            "$ref": "#/schemas/MemberRow"
          }
        },
        "additionalProperties": false
      },
      "MemberRow": {
        "type": "object",
        "description": "One member.",
        "required": [
          "id",
          "name",
          "profile",
          "tags",
          "owners"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/schemas/Profile"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owners": {
            "type": "array",
            "items": {
              "$ref": "#/schemas/Owner"
            }
          }
        },
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "required": [
          "name",
          "email",
          "timezone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "timezone": {
            "enum": [
              "UTC",
              "Asia/Seoul",
              "Europe/Berlin"
            ]
          }
        },
        "additionalProperties": false
      },
      "Owner": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "meta": {
    "command": "schema",
    "contract": "atip/1",
    "contractVersion": "1.2",
    "schemaVersion": "1.2",
    "tool": "acme",
    "toolVersion": "1.0.0"
  }
}
