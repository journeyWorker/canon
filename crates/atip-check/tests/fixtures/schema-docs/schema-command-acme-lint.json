{
  "ok": true,
  "data": {
    "kind": "command",
    "command": "lint",
    "path": [
      "lint"
    ],
    "summary": "Check project files for problems; with no file, the project file acme.yaml",
    "effect": "read",
    "operands": [
      {
        "name": "file",
        "valueName": "FILE",
        "valueType": "path",
        "required": false,
        "variadic": true,
        "default": [
          "acme.yaml"
        ],
        "help": "The files to check (default: acme.yaml)"
      }
    ],
    "options": [
      {
        "name": "input",
        "valueName": "JSON|FILE|-",
        "valueType": "string",
        "required": false,
        "repeatable": false,
        "default": null,
        "flagOnly": true,
        "help": "The arguments as one JSON object (inline, a file, or - for stdin)"
      },
      {
        "name": "json",
        "valueType": "switch",
        "required": false,
        "repeatable": false,
        "default": false,
        "flagOnly": true,
        "help": "Output JSON instead of the human-readable form"
      }
    ],
    "errors": [
      "FILE_NOT_FOUND",
      "INPUT_CONFLICT",
      "INPUT_INVALID",
      "INPUT_TOO_LARGE",
      "INTERNAL",
      "LINT_FAILED",
      "USAGE"
    ],
    "outputs": [
      {
        "kind": "report",
        "schemaRef": "#/schemas/LintReport",
        "schemaVersion": "1.0"
      }
    ],
    "input": {
      "option": "--input",
      "schemaRef": "#/schemas/LintInput",
      "argumentsRef": "#/schemas/LintArguments",
      "batch": false,
      "maxBytes": 65536,
      "example": {}
    },
    "examples": [
      "acme lint --json",
      "acme lint src/a.yaml src/b.yaml --json",
      "acme lint --input '{\"operands\":[\"src/a.yaml\"]}' --json"
    ],
    "schemas": {
      "LintReport": {
        "type": "object",
        "required": [
          "files",
          "clean"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "problems"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "problems": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "clean": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "LintInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "LintArguments": {
        "description": "The argument object: with no file given, operands is the default [\"acme.yaml\"] (spec 11.7 step 6), so it always has at least one file.",
        "type": "object",
        "required": [
          "operands"
        ],
        "additionalProperties": false,
        "properties": {
          "operands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  },
  "meta": {
    "command": "schema",
    "contract": "atip/1",
    "contractVersion": "1.2",
    "schemaVersion": "1.2",
    "tool": "acme",
    "toolVersion": "1.0.0"
  }
}
