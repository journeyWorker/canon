 "supersededBy038": {
  "change": "canon-0-38-provider-option",
  "option": "providers",
  "about": "`--providers` is not an option of any command in 0.38: `canon-0-38-provider-option` made the provider list the repeatable `--harness` and `--no-harness`, and `--providers` is refused with `USAGE` whatever its value. What 0.36.0 accepted and refused for it stays here as the record: the 0.37 CHANGELOG still has a row for each value 0.37 refused, and the 0.38 CHANGELOG has a row for each shape of the old value (`atip.provideroption.14`). `atip.optionforms.13` and `.16` read the options that are still declared (`accepted` and `refused` above), not these.",
  "classes": {
   "valid": "a list RFC-exact: `claude`, `claude,omp`, `none` (0.37 takes it)",
   "empty": "an empty value (0.36.0: no provider)",
   "blank": "only white space (0.36.0: no provider)",
   "uppercase": "an uppercase letter in a name or in `none` (`Claude`, `NONE`)",
   "empty-item": "an empty item (`claude,,pi`, `claude,`, `,omp`)",
   "space-around": "white space around the value or an item (` claude`, `claude, pi`)",
   "none-with-names": "`none` beside a name (`none,claude`)",
   "unknown": "a name that is no provider (`gemini`)",
   "duplicate": "one name twice (`claude,claude`; 0.37 takes it: the brief does not refuse it)"
  },
