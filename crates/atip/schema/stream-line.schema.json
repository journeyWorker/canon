{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atip.dev/1/stream-line.schema.json",
  "title": "atip/1 stream line",
  "description": "One NDJSON line of a stream command in JSON mode (spec 13.5): a start line first, event lines, an end line last. An event's `data` follows the output's eventRef. The order is a rule over the whole stream, checked by scripts/check.ts.",
  "oneOf": [
    { "$ref": "#/$defs/start" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/end" }
  ],
  "$defs": {
    "start": {
      "type": "object",
      "required": ["type", "contract", "tool", "toolVersion", "command", "schemaVersion"],
      "properties": {
        "type": { "const": "start" },
        "contract": { "const": "atip/1" },
        "contractVersion": { "x-atip-since": "1.1", "$ref": "envelope.schema.json#/$defs/meta/properties/contractVersion" },
        "tool": { "$ref": "envelope.schema.json#/$defs/meta/properties/tool" },
        "toolVersion": { "type": "string", "minLength": 1 },
        "command": { "$ref": "envelope.schema.json#/$defs/meta/properties/command" },
        "schemaVersion": { "$ref": "envelope.schema.json#/$defs/schemaVersion" },
        "output": {
          "description": "The stream output that runs; required when the command declares more than one output (spec 13.5.1).",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        }
      },
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "event" },
        "data": {}
      },
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "end": {
      "type": "object",
      "required": ["type", "result"],
      "properties": {
        "type": { "const": "end" },
        "result": { "$ref": "envelope.schema.json" }
      },
      "additionalProperties": false
    }
  }
}
