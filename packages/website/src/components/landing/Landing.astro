---
import { getCollection } from "astro:content";
import "../../styles/tokens.css";
import "../../styles/landing.css";
import PrPanel from "./PrPanel.astro";
import FlowTimeline from "./FlowTimeline.astro";
import CompareTable from "./CompareTable.astro";
import { strings, type Lang } from "./strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];

// Docs entry points, in sidebar order, with each page's own title and description.
const order = [
  "getting-started",
  "privacy",
  "concepts/canon",
  "concepts/trust-spine",
  "concepts/tiered-storage",
  "concepts/strategy-memory",
  "architecture",
  "cli",
  "examples",
];
const prefix = lang === "en" ? "" : `${lang}/`;
const all = await getCollection("docs");
const docs = order.flatMap((slug) => {
  const entry = all.find((e) => e.id === `${prefix}${slug}`);
  return entry
    ? [{ href: `${t.docsBase}${slug}/`, title: entry.data.title, description: entry.data.description ?? "" }]
    : [];
});

// Split a shell line into command and trailing comment.
const shell = (line: string) => {
  const m = line.match(/^(.*?)(^|\s)(#.*)$/);
  return m ? { cmd: m[1] + m[2], comment: m[3] } : { cmd: line, comment: "" };
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="ko" href="/ko/" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body class="lp">
    <header class="site-head">
      <a class="wordmark" href={t.base}>canon</a>
      <nav class="site-nav" aria-label={t.nav.label}>
        <a href={t.nav.docs.href}>{t.nav.docs.text}</a>
        <a href={t.nav.cli.href}>{t.nav.cli.text}</a>
        <a href={t.nav.concepts.href}>{t.nav.concepts.text}</a>
        <a href={t.nav.github.href}>{t.nav.github.text}</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-h">
        <div class="hero-copy">
          <h1 class="hero-h" id="hero-h">
            {t.headline.map((line) => <span>{line}</span>)}
          </h1>
          <div class="cmd" data-copy-root>
            <code class="cmd-text"><span class="cmd-prompt" aria-hidden="true">$ </span>{t.command}</code>
            <button
              type="button"
              class="cmd-copy"
              data-copy={t.command}
              data-copied={t.copied}
              aria-label={t.copyLabel}
            >
              <svg viewBox="0 0 27 29" width="27" height="29" aria-hidden="true">
                <path d="M7.5 20.5h-3a3 3 0 0 1-3-3V4a3 3 0 0 1 3-3H16a3 3 0 0 1 3 3v3" />
                <rect x="7.5" y="7" width="18" height="20.5" rx="3" />
              </svg>
              <span data-copy-text>{t.copy}</span>
            </button>
          </div>
          <span class="sr" role="status" data-copy-status></span>
        </div>
        <PrPanel t={t} />
      </section>

      <FlowTimeline t={t} />

      <CompareTable t={t} />

      <section class="sec quick" aria-labelledby="quick-h">
        <div class="sec-head">
          <h2 class="sec-h" id="quick-h">{t.quick.heading}</h2>
        </div>
        <div class="quick-body">
          <pre class="term"><code>{t.quick.demo.map((line) => {
            const { cmd, comment } = shell(line);
            return <span class="ln">{cmd}{comment && <span class="cm">{comment}</span>}</span>;
          })}</code></pre>
          <div class="quick-side">
            <p class="quick-after">{t.quick.after}</p>
            <h3 class="sub-h">{t.quick.anyRepo}</h3>
            <pre class="term"><code>{t.quick.repo.map((line) => {
              const { cmd, comment } = shell(line);
              return <span class="ln">{cmd}{comment && <span class="cm">{comment}</span>}</span>;
            })}</code></pre>
          </div>
        </div>
      </section>

      <section class="sec limits" aria-labelledby="limits-h">
        <div class="sec-head">
          <h2 class="sec-h" id="limits-h">{t.limits.heading}</h2>
        </div>
        <div class="limits-grid">
          <div class="limits-col is-yes">
            <p class="limits-lead">{t.limits.verifiesLead}</p>
            <ul class="limits-list">
              {t.limits.verifies.map((item) => (
                <li>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M3.5 8.5 6.5 11.5l6-7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="limits-col is-not">
            <p class="limits-lead">{t.limits.notLead}</p>
            <ul class="limits-list">
              {t.limits.not.map((item) => (
                <li>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <circle cx="8" cy="8" r="5.75" />
                    <path d="M4 12 12 4" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p class="limits-statement">{t.limits.statement}</p>
      </section>

      <section class="sec docs" aria-labelledby="docs-h">
        <div class="sec-head">
          <h2 class="sec-h" id="docs-h">{t.docs.heading}</h2>
        </div>
        <ul class="docs-list">
          {
            docs.map((d) => (
              <li>
                <a href={d.href}>
                  <span class="docs-title">{d.title}</span>
                  <span class="docs-desc">{d.description}</span>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M6 3.5 10.5 8 6 12.5" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer class="site-foot">
      <a class="wordmark" href={t.base}>canon</a>
      <p class="foot-status">{t.footer.status}</p>
      <nav class="foot-lang" aria-label={t.footer.language}>
        <a href="/" hreflang="en" lang="en" aria-current={lang === "en" ? "page" : undefined}>English</a>
        <a href="/ko/" hreflang="ko" lang="ko" aria-current={lang === "ko" ? "page" : undefined}>한국어</a>
      </nav>
      <a class="foot-gh" href={t.nav.github.href}>{t.nav.github.text}</a>
    </footer>

    <script>
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        const label = btn.querySelector<HTMLElement>("[data-copy-text]");
        const status = btn.closest("[data-copy-root]")?.nextElementSibling as HTMLElement | null;
        const original = label?.textContent ?? "";
        let timer = 0;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          } catch {
            return;
          }
          if (label) label.textContent = btn.dataset.copied ?? original;
          if (status) status.textContent = btn.dataset.copied ?? "";
          btn.classList.add("is-copied");
          clearTimeout(timer);
          timer = window.setTimeout(() => {
            if (label) label.textContent = original;
            if (status) status.textContent = "";
            btn.classList.remove("is-copied");
          }, 1600);
        });
      }
    </script>
  </body>
</html>
