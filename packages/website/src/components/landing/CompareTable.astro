---
// Fig. 3: what each tool owns next to what canon owns. Every claim about
// another tool links its primary source.
import type { Strings } from "./strings";

interface Props {
  t: Strings;
}
const { t } = Astro.props;
const { compare } = t;
const external = (href: string) => href.startsWith("http");
---

<section class="lp-sec lp-compare" aria-labelledby="compare-h">
  <h2 class="lp-h2" id="compare-h">{compare.heading}</h2>
  <p class="lp-lead">{compare.lead}</p>
  <figure class="fig3">
    <figcaption class="lp-cap">
      <span>{compare.number}</span>
      <span>{compare.title}</span>
    </figcaption>
    <table class="fig3-table">
      <colgroup>
        <col class="c-tool" />
        <col class="c-owns" />
        <col class="c-checks" />
        <col class="c-src" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col">{compare.cols.tool}</th>
          <th scope="col">{compare.cols.owns}</th>
          <th scope="col">{compare.cols.checks}</th>
          <th scope="col">{compare.cols.sources}</th>
        </tr>
      </thead>
      <tbody>
        {
          compare.rows.map((row) => (
            <tr class:list={{ "is-canon": row.tool === "canon" }}>
              <th scope="row">{row.tool}</th>
              <td data-label={compare.cols.owns}>{row.owns}</td>
              <td data-label={compare.cols.checks}>
                {row.checks}
                {row.note && <span class="fig3-note">{row.note}</span>}
              </td>
              <td data-label={compare.cols.sources}>
                <ul class="fig3-src">
                  {row.sources.map((s) => (
                    <li>
                      {external(s.href) ? (
                        <a href={s.href} rel="noopener" target="_blank">
                          {s.label}
                        </a>
                      ) : (
                        <a href={s.href}>{s.label}</a>
                      )}
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="fig3-foot">{compare.footnote}</p>
  </figure>
</section>
