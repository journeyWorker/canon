---
// Capability matrix: tools as rows, capabilities as columns. Each cell states
// yes / partial / no / not documented in words, and its note links the
// primary source the state was checked against.
import type { Strings, CellState } from "./strings";

interface Props {
  t: Strings;
}
const { t } = Astro.props;
const { compare } = t;
const external = (href: string) => href.startsWith("http");

const glyph: Record<CellState, string> = {
  yes: "M4.5 8.25 7 10.75l4.5-5",
  partial: "M8 3.25a4.75 4.75 0 0 1 0 9.5z",
  no: "M5.5 5.5l5 5M10.5 5.5l-5 5",
  nd: "M5.25 8h5.5",
};
---

<section class="sec cmp" aria-labelledby="cmp-h">
  <div class="sec-head">
    <h2 class="sec-h" id="cmp-h">{compare.heading}</h2>
    <p class="sec-lead">{compare.lead}</p>
  </div>
  <div class="cmp-scroll" role="region" aria-labelledby="cmp-h" tabindex="0">
    <table class="cmp-table">
      <thead>
        <tr>
          <th scope="col" class="cmp-corner">{compare.tool}</th>
          {compare.cols.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          compare.rows.map((row) => (
            <tr class:list={{ "is-canon": row.tool === "canon" }}>
              <th scope="row">
                <a href={row.href} {...(external(row.href) ? { rel: "noopener", target: "_blank" } : {})}>
                  {row.tool}
                </a>
              </th>
              {row.cells.map((cell) => (
                <td class={`st-${cell.state}`}>
                  <span class="cmp-state">
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                      <circle cx="8" cy="8" r="6.75" />
                      <path d={glyph[cell.state]} />
                    </svg>
                    {compare.states[cell.state]}
                  </span>
                  <a
                    class="cmp-note"
                    href={cell.href}
                    title={`${compare.source}: ${cell.source}`}
                    {...(external(cell.href) ? { rel: "noopener", target: "_blank" } : {})}
                  >
                    {cell.note}
                    <span class="sr"> ({compare.source}: {cell.source})</span>
                  </a>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="cmp-foot">
    <p><strong>canon</strong> · {compare.canonNote}</p>
    <p>{compare.footnote}</p>
  </div>
</section>
