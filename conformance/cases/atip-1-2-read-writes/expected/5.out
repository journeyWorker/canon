{"ok":true,"data":{"kind":"command","command":"dashboard","path":["dashboard"],"summary":"Serve the local status dashboard","effect":"write","idempotency":"replay-safe","effectNote":"prints one report, then serves until signalled; regenerates .canon/dashboard-snapshot; POST /api/briefs/approve rewrites a brief","operands":[],"options":[{"name":"repo","valueName":"DIR","valueType":"path","required":false,"repeatable":false,"default":null,"defaultNote":"the nearest ancestor directory holding a canon.yaml","flagOnly":true,"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)"},{"name":"snapshot","valueName":"DIR","valueType":"path","required":false,"repeatable":false,"default":null,"defaultNote":"regenerated fresh each run","help":"Snapshot dir to serve (default: regenerated fresh each run)"},{"name":"port","valueName":"N","valueType":"integer","required":false,"repeatable":false,"default":4173,"domain":{"maximum":65535,"minimum":0},"help":"Local port to bind (0 = OS-assigned free port)"},{"name":"json","valueType":"switch","required":false,"repeatable":false,"default":false,"flagOnly":true,"help":"Print one JSON document naming the address it serves (`data.url`), then serve until stopped; the human lines go to stderr"},{"name":"input","valueName":"JSON|FILE|-","valueType":"string","required":false,"repeatable":false,"default":null,"flagOnly":true,"help":"The arguments as JSON: an object (one run) or an array / NDJSON file or `-` (a batch); keys are the option names in camelCase, `operands` an array"},{"name":"as","valueName":"ROLE","valueType":"enum","possibleValues":["planner","implementer","reviewer","orchestrator"],"required":false,"repeatable":false,"default":null,"env":"CANON_ROLE","flagOnly":true,"help":"The role you act as: planner, implementer, reviewer or orchestrator. Overrides `CANON_ROLE`. `schema` and `context` list only the role's commands, `status` keeps its steps, and `--role` on `evidence add` / `evidence audit` / `review scenario` / `review change` is this role unless given"}],"errors":["APPROVAL_INVALID","BRIEF_INVALID","BRIEF_NOT_FOUND","BRIEF_PAGE_STALE","CONFIG_INVALID","DASHBOARD_FAILED","DASHBOARD_PORT_UNAVAILABLE","DASHBOARD_REQUEST_DENIED","DASHBOARD_REQUEST_INVALID","DASHBOARD_UNSUPPORTED","INPUT_CONFLICT","INPUT_INVALID","INPUT_TOO_LARGE","INTERNAL","REPO_DENIED","REPO_INVALID","REPO_LOCK_UNAVAILABLE","ROLE_INVALID","USAGE","WRITE_DENIED","WRITE_INVALID"],"outputs":[{"kind":"report","schemaRef":"#/schemas/DashboardReport","schemaVersion":"1.1"}],"input":{"option":"--input","schemaRef":"#/schemas/DashboardInput","argumentsRef":"#/schemas/DashboardArguments","batch":false,"maxBytes":8388608,"example":{}},"examples":["canon dashboard --json"],"schemas":{"DashboardArguments":{"additionalProperties":false,"properties":{"port":{"description":"Local port to bind (0 = OS-assigned free port)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"snapshot":{"description":"Snapshot dir to serve (default: regenerated fresh each run)","type":"string"}},"title":"`canon dashboard` arguments after the --input document is merged with the command line","type":"object"},"DashboardInput":{"additionalProperties":false,"properties":{"port":{"description":"Local port to bind (0 = OS-assigned free port)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"snapshot":{"description":"Snapshot dir to serve (default: regenerated fresh each run)","type":"string"}},"title":"`canon dashboard` --input document","type":"object"},"DashboardReport":{"description":"`canon dashboard --json`: where the dashboard serves (`DashboardReport`).","properties":{"app":{"description":"Where the app comes from: the embedded build, or a directory.","type":"string"},"briefsUrl":{"type":"string"},"nextOmitted":{"description":"How many further `meta.next` steps were left out past the limit","minimum":1,"type":"integer"},"snapshot":{"type":"string"},"snapshotAvailable":{"type":"boolean"},"unchanged":{"description":"true when a repeat found its work already done with identical content and wrote nothing; absent otherwise","type":"boolean"},"url":{"type":"string"},"waitingOn":{"additionalProperties":{"minimum":0,"type":"integer"},"description":"With a declared role: how many steps each other owner holds (`human` for the steps only the human takes)","type":"object"}},"required":["url","briefsUrl","app","snapshot","snapshotAvailable"],"title":"DashboardReport","type":"object"}},"x-canon":{"roles":["orchestrator"]}},"meta":{"command":"schema","schemaVersion":"1.2","tool":"canon","toolVersion":"0.35.0","contract":"atip/1","contractVersion":"1.2"}}
