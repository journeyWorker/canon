{"ok":true,"data":{"kind":"command","command":"dashboard","summary":"Serve the local status dashboard","effect":"write","idempotency":"replay-safe","effectNote":"prints one report, then serves until signalled; regenerates .canon/dashboard-snapshot; POST /api/briefs/approve rewrites a brief","options":["repo",{"name":"snapshot","valueName":"DIR","valueType":"path","defaultNote":"regenerated fresh each run","help":"Snapshot dir to serve (default: regenerated fresh each run)"},{"name":"port","valueName":"N","valueType":"integer","default":4173,"domain":{"maximum":65535,"minimum":0},"help":"Local port to bind (0 = OS-assigned free port)"},"as"],"errors":["BRIEF_INVALID","BRIEF_NOT_FOUND","BRIEF_PAGE_STALE","CONFIG_INVALID","DASHBOARD_FAILED","DASHBOARD_PORT_UNAVAILABLE","DASHBOARD_REQUEST_DENIED","DASHBOARD_REQUEST_INVALID","DASHBOARD_UNSUPPORTED","REPO_DENIED","REPO_INVALID","REPO_LOCK_UNAVAILABLE","REPO_UNAVAILABLE","ROLE_INVALID","WRITE_DENIED","WRITE_INVALID"],"outputs":[{"schemaRef":"#/schemas/DashboardReport","schemaVersion":"1.1"}],"input":{"argumentsRef":"#/schemas/DashboardArguments","maxBytes":8388608,"example":{}},"examples":["canon dashboard --json"],"x-canon":{"roles":["orchestrator"]}},"meta":{"command":"schema","schemaVersion":"1.4","tool":"canon","toolVersion":"0.35.0","contract":"atip/1","contractVersion":"1.4"}}
