{"ok":true,"data":{"kind":"command","command":"subject show","summary":"Show a subject (read-only)","effect":"read","effectNote":"refreshes the stale scenario-index cache once the subject is found; a refused call writes nothing","operands":[{"name":"subject","valueName":"SUBJECT_ID","required":true,"domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"The subject to show"}],"options":["repo","as"],"errors":["CHANGE_ADOPTION_INCOMPLETE","CHANGE_NOT_FOUND","CONFIG_INVALID","CONFIG_REQUIRED","REPO_DENIED","REPO_INVALID","REPO_UNAVAILABLE","ROLE_INVALID","SUBJECT_NOT_FOUND","WRITE_DENIED","WRITE_FAILED","WRITE_INVALID"],"outputs":[{"schemaRef":"#/schemas/SubjectShowReport"}],"examples":["canon subject show demo --json"],"x-canon":{"roles":["orchestrator"]}},"meta":{"command":"schema","schemaVersion":"1.6","tool":"canon","toolVersion":"0.41.0","contract":"atip/1","contractVersion":"1.6"}}
