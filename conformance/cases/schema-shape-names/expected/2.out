{"ok":true,"data":{"kind":"command","command":"trace","summary":"Follow a finding's review loop in time order: review, finding, fix, re-review, evidence","effect":"read","effectNote":"first brings the derived index up to date: writes the gitignored .canon/index/search.db (and the -wal and -shm files SQLite may add) and .canon/index/.gitignore when an input changed or the index is missing; a current index is not written","operands":[{"name":"trace","valueName":"TRACE_ID","required":true,"domain":{"pattern":"^\\p{White_Space}*([0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}|[0-9A-Fa-f]{7,40}|[^\u0000]+_[0-9]+_[0-9]+)\\p{White_Space}*$"},"help":"A review id (26 characters), a commit sha (7 to 40 hex digits) or a finding key (`<change>_<round>_<seq>`)"}],"options":["repo","as"],"errors":["CONFIG_DENIED","CONFIG_INVALID","CONFIG_REQUIRED","CONFIG_UNAVAILABLE","ROLE_INVALID","SEARCH_INDEX_FAILED","TRACE_CONFLICT","TRACE_NOT_FOUND"],"outputs":[{"schemaRef":"#/schemas/TraceReport"}],"examples":["canon trace add-login_1_1 --json"],"x-canon":{"roles":"all"}},"meta":{"command":"schema","schemaVersion":"1.6","tool":"canon","toolVersion":"0.41.0","contract":"atip/1","contractVersion":"1.6"}}
