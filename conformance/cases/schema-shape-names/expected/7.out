{"ok":true,"data":{"kind":"command","command":"dispatch begin","summary":"Mint a Run manifest with retrieved guidance and context/policy lineage","effect":"write","idempotency":"appends","options":[{"name":"role","defaultNote":"the role declared with --as or CANON_ROLE","env":"CANON_ROLE","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"Role about to run; must equal --regime's leading segment"},{"name":"regime","valueName":"KEY","required":true,"domain":{"pattern":"^[^/\\p{White_Space}]+/[^/\\p{White_Space}]+/[^/\\p{White_Space}]+/[0-9a-f]{6,64}$"},"help":"Full regime key (<role>/<repo>/<area>/<hash>) to retrieve guidance for"},{"name":"actor","valueName":"ACTOR_ID","default":"canon","domain":{"pattern":"^\\p{White_Space}*([^\\p{Cc}\\p{Zl}\\p{Zp}]*[^\\p{Cc}\\p{White_Space}])\\p{White_Space}*$"},"help":"The dispatching agent's id (recorded as the run's actor)"},"session",{"name":"provider","valueName":"NAME","help":"Declared provider metadata (copied verbatim; never inferred from --actor)"},{"name":"model","valueName":"NAME","help":"Declared model metadata (copied verbatim)"},{"name":"skill","valueName":"SKILL_ID","help":"Skill that contributed to this run"},{"name":"skill-digest","valueName":"DIGEST","help":"Declared skill digest; requires --skill"},{"name":"manifest","valueName":"FILE","valueType":"path","help":"Explicit repository-relative ContextPack input manifest"},{"name":"prompt-bundle","valueName":"NAME@VERSION","domain":{"pattern":"^[^@]+@[^@]+$"},"help":"Registered prompt bundle to select (`name@version`)"},{"name":"task","valueName":"TASK_ID","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*#[0-9]+(\\.[0-9]+)*$"},"help":"Plan task this run serves (<change_id>#<n>); validated against the plan corpus"},{"name":"parent-run","valueName":"RUN_ID","domain":{"pattern":"^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"},"help":"RunId (ULID) of the run that dispatched this one"},"repo","as"],"constraints":[{"rule":"requires","if":{"name":"skill-digest"},"then":["skill"],"code":"DISPATCH_ARGUMENT_INVALID","help":"A skill digest is the digest of a named skill."}],"validators":[{"arguments":["role","regime"],"code":"DISPATCH_ROLE_CONFLICT","description":"`--role` must equal the first segment of `--regime` (`<role>/<repo>/<area>/<hash>`)."}],"errors":["CONFIG_DENIED","CONFIG_INVALID","DISPATCH_CONFLICT","DISPATCH_MANIFEST_CORRUPT","DISPATCH_MANIFEST_DENIED","DISPATCH_MANIFEST_UNAVAILABLE","DISPATCH_ROLE_CONFLICT","DISPATCH_RUN_NOT_FOUND","DISPATCH_RUN_UNAVAILABLE","LAYOUT_MIGRATION_REQUIRED","PLAN_CORPUS_DENIED","PLAN_CORPUS_INVALID","PLAN_CORPUS_UNAVAILABLE","PLAN_SOURCES_REQUIRED","REPO_LOCK_UNAVAILABLE","ROLE_INVALID","SERIALIZE_FAILED","TASK_NOT_FOUND","WRITE_DENIED","WRITE_FAILED","WRITE_INVALID"],"outputs":[{"schemaRef":"#/schemas/DispatchBeginReport","schemaVersion":"1.1"},{"schemaRef":"#/schemas/BatchDispatchBeginReport","schemaVersion":"1.1","batch":true,"when":"--input is an array or NDJSON"}],"input":{"argumentsRef":"#/schemas/DispatchBeginArguments","batch":true,"maxBytes":8388608,"maxItems":10000,"example":{"regime":"implementer/my-repo/api/abcdef012345","role":"implementer"}},"examples":["canon dispatch begin --regime implementer/my-repo/api/abcdef012345 --role implementer --json"],"x-canon":{"roles":["orchestrator"]}},"meta":{"command":"schema","schemaVersion":"1.5","tool":"canon","toolVersion":"0.38.0","contract":"atip/1","contractVersion":"1.5"}}
