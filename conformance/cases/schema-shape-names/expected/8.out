{"ok":true,"data":{"kind":"command","command":"evidence audit","summary":"Record an external evaluator's re-audit of one scenario (class `audit`; the verdict follows --audit-result; canon never runs the evaluator)","effect":"write","idempotency":"content-keyed","effectNote":"refreshes stale scenario-index records once nothing refuses the call; a refused call writes nothing","operands":[{"name":"scenario","valueName":"SCENARIO_ID","required":true,"domain":{"pattern":"^[a-z0-9-]+\\.[a-z0-9-]+\\.[0-9]{2,}$"},"help":"The re-audited scenario (`<area>.<surface>.<nn>`)"}],"options":[{"name":"project","valueName":"PROJECT_ID","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"Spec corpus id of the scenario. Required only when canon.yaml configures more than one spec root; refused (SPEC_ROOT_NOT_FOUND) when it names none"},{"name":"ref","valueName":"TEXT","required":true,"domain":{"pattern":"^[^\u0000]*\\P{White_Space}[^\u0000]*$"},"help":"The reference a reader can resolve: a command line, commit sha, or report path. NEVER run or resolved by canon"},{"name":"summary","valueName":"TEXT","domain":{"pattern":"^\\p{White_Space}*([^\\p{Cc}\\p{Zl}\\p{Zp}]*[^\\p{Cc}\\p{White_Space}])\\p{White_Space}*$"},"help":"One line of text (scanned for fabrication markers). The white space around it is trimmed; a control character or line break inside it is refused"},"command-result","run",{"name":"actor","valueName":"ACTOR_ID","default":"canon","domain":{"pattern":"^\\p{White_Space}*([^\\p{Cc}\\p{Zl}\\p{Zp}]*[^\\p{Cc}\\p{White_Space}])\\p{White_Space}*$"},"help":"The attesting actor's id (recorded as the attestation's author). One line of text: the white space around it is trimmed; a control character or line break inside it is refused"},{"name":"role","defaultNote":"the role declared with --as or CANON_ROLE","env":"CANON_ROLE","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"The attesting role; `canon gate promote` derives its run_seq partition key from it. Default: the declared role (--as / CANON_ROLE); required when none is declared"},{"name":"session","valueName":"SESSION_ID","domain":{"pattern":"^[^\\p{Cc}\\p{White_Space}]([^\\p{Cc}]*[^\\p{Cc}\\p{White_Space}])?$"},"help":"The attesting session (recorded as actor.session_id)"},"rev",{"name":"artifact","valueName":"PATH","valueType":"path","repeatable":true,"help":"EXPERIMENTAL: bind any file (trace, log, report) by sha256; repeatable; must be inside the repo"},"report",{"name":"report-case","valueName":"NAME","repeatable":true,"help":"EXPERIMENTAL: also bind this report case (a Rust test: its function name); repeatable"},"max-artifact-mib",{"name":"evaluator","valueName":"EVALUATOR_ID","required":true,"domain":{"pattern":"^\\P{White_Space}([\\P{White_Space}\\p{Zs}\\t]*\\P{White_Space})?$"},"help":"The external evaluator that re-audited the scenario (canon never runs it)"},{"name":"evaluator-version","valueName":"TEXT","required":true,"domain":{"pattern":"^\\P{White_Space}([\\P{White_Space}\\p{Zs}\\t]*\\P{White_Space})?$"},"help":"The evaluator's version"},{"name":"evaluator-digest","valueName":"DIGEST","required":true,"domain":{"pattern":"^[0-9a-f]{64}$"},"help":"sha256 of the evaluator (64 lowercase hex)"},{"name":"audit-result","valueName":"RESULT","valueType":"enum","possibleValues":["confirmed","refuted","indeterminate"],"required":true,"help":"confirmed / refuted / indeterminate; the record's verdict follows it (confirmed → faithful, refuted → divergent, indeterminate → not-applicable)"},"override-reason","promote","no-promote","repo","as"],"constraints":[{"rule":"atMostOne","names":["promote","no-promote"]},{"rule":"requires","if":{"name":"report-case"},"then":["report"],"code":"EVIDENCE_ARGUMENT_REQUIRED","help":"--report-case names a case of a --report."},{"rule":"requires","if":{"name":"command-result"},"then":["summary"],"code":"EVIDENCE_ARGUMENT_REQUIRED","help":"The captured output backs a --summary."}],"validators":[{"arguments":["artifact","scenario"],"code":"EVIDENCE_ARGUMENT_CONFLICT","description":"An `--artifact` binds to one record: a scoped `--artifact <scenario-id>=<path>` must name the audited scenario. The part before the first `=` is a scope only when it is shaped like a scenario id."}],"errors":["ARTIFACTS_DIGEST_INVALID","ARTIFACTS_STORE_DENIED","ARTIFACTS_STORE_INVALID","ARTIFACTS_STORE_REQUIRED","ARTIFACTS_STORE_UNAVAILABLE","BRIEF_APPROVAL_REQUIRED","BRIEF_APPROVAL_STALE","BRIEF_MIGRATION_REQUIRED","COMMIT_REQUIRED","CONFIG_DENIED","CONFIG_INVALID","CONFIG_REQUIRED","CONFIG_UNAVAILABLE","EVIDENCE_ARGUMENT_CONFLICT","EVIDENCE_BINDING_DENIED","EVIDENCE_BINDING_INVALID","EVIDENCE_BINDING_NOT_FOUND","EVIDENCE_BINDING_UNAVAILABLE","EVIDENCE_CONTRACT_CONFLICT","EVIDENCE_INCOMPLETE","EVIDENCE_NOTE_INVALID","EVIDENCE_REPORT_CONFLICT","EVIDENCE_STALE","LAYOUT_MIGRATION_REQUIRED","PROMOTION_FAILED","PROMOTION_INVALID","REPO_DENIED","REPO_INVALID","REPO_LOCK_UNAVAILABLE","REPO_UNAVAILABLE","ROLE_INVALID","SPEC_ROOT_NOT_FOUND","SUBJECT_APPROVAL_REQUIRED","SUBJECT_INVALID","TASK_EVIDENCE_INVALID","TYPED_ATOMS_INVALID","WRITE_DENIED","WRITE_FAILED","WRITE_INVALID"],"outputs":[{"schemaRef":"#/schemas/EvidenceAuditReport","schemaVersion":"1.2"},{"schemaRef":"#/schemas/BatchEvidenceAuditReport","schemaVersion":"1.1","batch":true,"when":"--input is an array or NDJSON"}],"input":{"argumentsRef":"#/schemas/EvidenceAuditArguments","batch":true,"maxBytes":8388608,"maxItems":10000,"example":{"auditResult":"confirmed","evaluator":"eval-1","evaluatorDigest":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef","evaluatorVersion":"2.1","operands":["auth.login.01"],"ref":"audit-report.json","role":"implementer"}},"examples":["canon evidence audit auth.login.01 --ref audit-report.json --evaluator eval-1 --evaluator-version 2.1 --evaluator-digest 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --audit-result confirmed --role implementer --json"],"x-canon":{"roles":["implementer"]}},"meta":{"command":"schema","schemaVersion":"1.5","tool":"canon","toolVersion":"0.39.0","contract":"atip/1","contractVersion":"1.5"}}
