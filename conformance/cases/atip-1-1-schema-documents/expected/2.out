{"ok":true,"data":{"kind":"group","command":"finding","summary":"Record one code-review finding as a durable record","commands":[{"command":"finding add","summary":"Record one code-review finding (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding close","summary":"Move an already-committed finding's disposition (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding list","summary":"List a change's committed findings at their latest version: round, seq, severity, disposition, reviewer and summary","effect":"read","x-canon":{"roles":"all"}}]},"meta":{"command":"schema","schemaVersion":"1.5","tool":"canon","toolVersion":"0.40.0","contract":"atip/1","contractVersion":"1.5"}}
