{"ok":true,"data":{"kind":"group","command":"finding","path":["finding"],"summary":"Record one code-review finding as a durable record","commands":[{"command":"finding add","path":["finding","add"],"kind":"command","summary":"Record one code-review finding (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding close","path":["finding","close"],"kind":"command","summary":"Move an already-committed finding's disposition (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding list","path":["finding","list"],"kind":"command","summary":"List a change's committed findings at their latest version: round, seq, severity, disposition, reviewer and summary","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}}]},"meta":{"command":"schema","schemaVersion":"1.2","tool":"canon","toolVersion":"0.35.0","contract":"atip/1","contractVersion":"1.2"}}
