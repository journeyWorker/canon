{"ok":true,"data":{"kind":"schemas","command":"finding close","schemas":{"BatchFindingCloseReport":{"description":"`Batch<Name>Report`: the `data` of a leaf run with a JSON array or NDJSON as `--input`.\n`R` is the leaf's ordinary report; the binary itself carries each element's report as JSON.","properties":{"items":{"items":{"$ref":"#/schemas/BatchItem"},"type":"array"},"nextOmitted":{"description":"How many further `meta.next` steps were left out past the limit","minimum":1,"type":"integer"},"unchanged":{"description":"true when a repeat found its work already done with identical content and wrote nothing; absent otherwise","type":"boolean"},"waitingOn":{"additionalProperties":{"minimum":0,"type":"integer"},"description":"With a declared role: how many steps each other owner holds (`human` for the steps only the human takes)","type":"object"}},"required":["items"],"title":"BatchReport","type":"object"},"BatchFindingCloseReportFindingCloseReport":{"description":"`canon finding close`: the transition staged or committed, or a no-op.","properties":{"changeId":{"type":"string"},"committed":{"type":["string","null"]},"disposition":{"type":"string"},"from":{"description":"The disposition it moved from; absent when unchanged.","type":["string","null"]},"round":{"format":"uint32","minimum":0,"type":"integer"},"seq":{"format":"uint32","minimum":0,"type":"integer"},"staged":{"type":["string","null"]}},"required":["changeId","round","seq","disposition"],"type":"object"},"BatchItem":{"description":"One element of a batch, in input order.","properties":{"data":{"anyOf":[{"$ref":"#/schemas/BatchFindingCloseReportFindingCloseReport"},{"type":"null"}],"description":"The element's ordinary report: a `written` or `unchanged` element has one, a `failed` or `skipped` one has none."},"error":{"anyOf":[{"$ref":"#/schemas/ErrorBody"},{"type":"null"}],"description":"The element's ordinary error, its `field` a pointer into the batch (`/2/scenario`)."},"index":{"description":"0-based position in the input.","format":"uint","minimum":0,"type":"integer"},"status":{"$ref":"#/schemas/ItemStatus"}},"required":["index","status"],"type":"object"},"ErrorBody":{"description":"The `error` member of a failure envelope. Field order is the document\norder: `code` first. An optional member with no value is left out of the\ndocument, so the body validates against the contract's error schema.","properties":{"code":{"description":"Stable SCREAMING_SNAKE code a caller branches on, registered in the tool's error registry.","type":"string"},"details":{"description":"Every error of an input that yields several, in the order the tool found them (spec 7.1.1); absent for one error.","items":{"$ref":"#/schemas/ErrorDetailBody"},"type":["array","null"]},"expected":{"description":"The valid values of `field`, when it takes a closed set.","items":{"type":"string"},"type":["array","null"]},"field":{"description":"The refused argv name (`--scenario`) or an RFC 6901 JSON pointer into `--input`.","type":["string","null"]},"hint":{"description":"A working invocation or the next step.","type":["string","null"]},"message":{"type":"string"},"reason":{"description":"Which of the situations registered under `code` this is (since 1.1); registered in the code's row.","type":["string","null"]},"received":{"description":"The value that was refused, with secrets redacted; `\"\"` for an empty value the caller sent (1.1).","type":["string","null"]},"retryable":{"description":"True only where running the same command again can succeed; equal to the registry row's.","type":"boolean"},"suggestions":{"description":"The nearest valid commands, options or values.","items":{"type":"string"},"type":"array"}},"required":["code","message","retryable"],"type":"object"},"ErrorDetailBody":{"description":"One item of `details` (spec 7.1.1): the members of [`ErrorBody`] except `retryable` and `details`.","properties":{"code":{"type":"string"},"expected":{"items":{"type":"string"},"type":["array","null"]},"field":{"type":["string","null"]},"hint":{"type":["string","null"]},"message":{"type":"string"},"reason":{"type":["string","null"]},"received":{"type":["string","null"]},"suggestions":{"items":{"type":"string"},"type":"array"}},"required":["code","message"],"type":"object"},"FindingCloseArguments":{"additionalProperties":false,"properties":{"actor":{"description":"The actor recorded as authoring the TRANSITION — not the original finding's author, which is preserved on the record this supersedes","type":"string"},"disposition":{"description":"Where it lands: fixed / rejected / deferred (`open` is refused: a defect that came back is a new finding). fixed records --resolution-rev, default HEAD, and only fixed may carry one","enum":["fixed","rejected","deferred"]},"noPromote":{"description":"Keep this write staged even under canon.yaml `write: { promote: auto }`","type":"boolean"},"operands":{"description":"The change under review — first component of the natural key","items":{"type":"string"},"maxItems":1,"minItems":1,"type":"array"},"promote":{"description":"Promote the record this run staged, in the same run; records others staged stay staged (the default under canon.yaml `write: { promote: auto }`)","type":"boolean"},"reason":{"description":"Why it was closed, one line. Required for rejected and deferred, optional for fixed; stored on the closing version and shown by `finding list`","type":"string"},"resolutionRev":{"description":"The commit that closed it, any git revision (resolved to the full sha, with the code tree it saw). Permitted only with --disposition fixed, where it defaults to HEAD. Existence only; canon never reads the commit's message or diff","type":"string"},"role":{"description":"The role the close is recorded under: the declared one (--as, CANON_ROLE), and --role only when it names that role or none is declared; no role is recorded when neither is given. Only a reviewer closes as rejected or deferred","type":"string"},"round":{"description":"Which review round raised it (1-based)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"seq":{"description":"The finding's index within the round (1-based)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"session":{"description":"The session that authored the TRANSITION (recorded as actor.session_id)","type":"string"}},"required":["operands","round","seq","disposition"],"title":"`canon finding close` arguments after the --input document is merged with the command line","type":"object"},"FindingCloseReport":{"description":"`canon finding close`: the transition staged or committed, or a no-op.","properties":{"changeId":{"type":"string"},"committed":{"type":["string","null"]},"disposition":{"type":"string"},"from":{"description":"The disposition it moved from; absent when unchanged.","type":["string","null"]},"nextOmitted":{"description":"How many further `meta.next` steps were left out past the limit","minimum":1,"type":"integer"},"round":{"format":"uint32","minimum":0,"type":"integer"},"seq":{"format":"uint32","minimum":0,"type":"integer"},"staged":{"type":["string","null"]},"unchanged":{"description":"true when a repeat found its work already done with identical content and wrote nothing; absent otherwise","type":"boolean"},"waitingOn":{"additionalProperties":{"minimum":0,"type":"integer"},"description":"With a declared role: how many steps each other owner holds (`human` for the steps only the human takes)","type":"object"}},"required":["changeId","round","seq","disposition"],"title":"FindingCloseReport","type":"object"},"Input":{"type":"object","additionalProperties":false,"properties":{"operands":{"type":"array","minItems":1,"maxItems":1,"prefixItems":[{"type":"string"}],"items":false},"round":{"anyOf":[{"type":"integer"},{"type":"string","pattern":"^-?(0|[1-9][0-9]*)$"}]},"seq":{"anyOf":[{"type":"integer"},{"type":"string","pattern":"^-?(0|[1-9][0-9]*)$"}]},"disposition":{"enum":["fixed","rejected","deferred"]},"resolutionRev":{"type":"string"},"reason":{"type":"string"},"actor":{"type":"string"},"role":{"type":"string"},"session":{"type":"string"},"promote":{"type":"boolean"},"noPromote":{"type":"boolean"}}},"ItemStatus":{"description":"What happened to one element of a batch.","oneOf":[{"const":"written","description":"The element ran and wrote.","type":"string"},{"const":"unchanged","description":"The element ran and found its record already present with identical content.","type":"string"},{"const":"failed","description":"The element ran and failed; `error` says why.","type":"string"},{"const":"skipped","description":"An earlier element failed, so this one never ran.","type":"string"}]}}},"meta":{"command":"schema","schemaVersion":"1.5","tool":"canon","toolVersion":"0.40.0","contract":"atip/1","contractVersion":"1.5"}}
