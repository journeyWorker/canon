{"ok":true,"data":{"kind":"tree","level":"L2","commands":[{"command":"adapter","path":["adapter"],"kind":"group","summary":"Validate a provider-neutral adapter response without executing a provider"},{"command":"adapter authorize","path":["adapter","authorize"],"kind":"command","summary":"Authorize declared capabilities against repository policy (preflight only)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"adapter validate","path":["adapter","validate"],"kind":"command","summary":"Read and validate one provider-neutral response envelope","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"artifacts","path":["artifacts"],"kind":"group","summary":"Check or move the evidence artifact store (local, or an object-store tier)"},{"command":"artifacts move","path":["artifacts","move"],"kind":"command","summary":"Move the local artifact blobs to an object-store tier, verify them, and remove the local copies","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"artifacts store","path":["artifacts","store"],"kind":"command","summary":"Store the bound files of existing evidence records and current reviews in the artifact store (.canon/artifacts/sha256/)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"artifacts verify","path":["artifacts","verify"],"kind":"command","summary":"Check that the artifact store holds every file the latest evidence and current reviews bind (--full re-hashes the stored bytes)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"brief","path":["brief"],"kind":"group","summary":"Check a change's brief (PRD format) and see the next steps; never edits"},{"command":"brief approve","path":["brief","approve"],"kind":"command","summary":"Record the human's approval of the brief, bound to its text; refused while `brief check` has blockers","effect":"write","x-canon":{"roles":[]}},{"command":"brief check","path":["brief","check"],"kind":"command","summary":"Read the brief against the rules: blocker and advisory findings (exit 0 clean, 1 blockers, 2 refused)","effect":"read","x-canon":{"roles":["planner","reviewer"]}},{"command":"brief show","path":["brief","show"],"kind":"command","summary":"Show where the change stands and the next one to three steps; never edits","effect":"read","x-canon":{"roles":["planner","reviewer"]}},{"command":"change","path":["change"],"kind":"group","summary":"Write a plan change (.canon/changes/<slug>/brief.md) and adopt it into a subject"},{"command":"change new","path":["change","new"],"kind":"command","summary":"Write .canon/changes/<slug>/brief.md, import it, and adopt it into a subject","effect":"write","x-canon":{"roles":["planner"]}},{"command":"completion","path":["completion"],"kind":"command","summary":"Write the shell completion script for canon (bash, zsh or fish)","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"context","path":["context"],"kind":"command","summary":"Show what you can author here: record kinds, fields, enums, policies","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"context-pack","path":["context-pack"],"kind":"group","summary":"Create, inspect, and verify reproducible context packs"},{"command":"context-pack add","path":["context-pack","add"],"kind":"command","summary":"Create an immutable context pack from a repository-local JSON manifest","effect":"write","x-canon":{"roles":["orchestrator","implementer"]}},{"command":"context-pack show","path":["context-pack","show"],"kind":"command","summary":"Show a context pack after verifying its manifest and content objects","effect":"read","x-canon":{"roles":["orchestrator","implementer"]}},{"command":"context-pack verify","path":["context-pack","verify"],"kind":"command","summary":"Verify a context pack's manifest and immutable content objects","effect":"read","x-canon":{"roles":["orchestrator","implementer"]}},{"command":"dashboard","path":["dashboard"],"kind":"command","summary":"Serve the local status dashboard","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"demo","path":["demo"],"kind":"group","summary":"Try the evidence loop end-to-end in a throwaway demo repo"},{"command":"demo init","path":["demo","init"],"kind":"command","summary":"Scaffold the demo repo (gate starts RED)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"demo review","path":["demo","review"],"kind":"command","summary":"Record the missing reviewer evidence (gate turns GREEN)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"dispatch","path":["dispatch"],"kind":"group","summary":"Begin an agent run with retrieved guidance recorded"},{"command":"dispatch begin","path":["dispatch","begin"],"kind":"command","summary":"Mint a Run manifest with retrieved guidance and context/policy lineage","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"dispatch diff","path":["dispatch","diff"],"kind":"command","summary":"Diff the declared plan DAG against the observed execution graph","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"dispatch end","path":["dispatch","end"],"kind":"command","summary":"Close a dispatched run with a terminal status and an ended_at","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"divergence","path":["divergence"],"kind":"group","summary":"Stage, promote, resolve, and inspect spec divergences"},{"command":"divergence accept","path":["divergence","accept"],"kind":"command","summary":"Accept a divergent scenario as a tracked known gap (a reviewer step): its latest evidence must be divergent and not the accepting actor's or session's. The acceptance pins that evidence, so new evidence ends it, and lapses at --expiry; until then the ship guard counts the cell as covered while `status` and `gate check` list it as `accepted-divergence`","effect":"write","x-canon":{"roles":[]}},{"command":"divergence add","path":["divergence","add"],"kind":"command","summary":"Add a divergence candidate, staged with no run_seq yet (commit it with `canon gate promote --kind divergence`, or in the same run with --promote / `write: { promote: auto }`)","effect":"write","x-canon":{"roles":["implementer","reviewer"]}},{"command":"divergence defer","path":["divergence","defer"],"kind":"command","summary":"Directly record a deferred divergence (requires --reason/--expiry)","effect":"write","x-canon":{"roles":["implementer","reviewer"]}},{"command":"divergence list","path":["divergence","list"],"kind":"command","summary":"List the current divergence burn-down state","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"divergence resolve","path":["divergence","resolve"],"kind":"command","summary":"Directly record a resolved divergence","effect":"write","x-canon":{"roles":["implementer","reviewer"]}},{"command":"evidence","path":["evidence"],"kind":"group","summary":"Author a staged, attributed evidence attestation for a plan task"},{"command":"evidence add","path":["evidence","add"],"kind":"command","summary":"Record one attributed EvidenceRecord for a task or scenario (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"evidence approval-payload","path":["evidence","approval-payload"],"kind":"command","summary":"Emit exact bytes for external `ssh-keygen -Y sign -n canon-approval-v1`","effect":"read","x-canon":{"roles":["implementer","orchestrator"]}},{"command":"evidence audit","path":["evidence","audit"],"kind":"command","summary":"Record an external evaluator's re-audit of one scenario (class `audit`; the verdict follows --audit-result; canon never runs the evaluator)","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"export","path":["export"],"kind":"command","summary":"Export a redacted retention manifest without deleting records","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"feature","path":["feature"],"kind":"group","summary":"Scaffold a new .feature spec file"},{"command":"feature new","path":["feature","new"],"kind":"command","summary":"Create a fresh .feature file for a new area.surface","effect":"write","x-canon":{"roles":["planner","implementer"]}},{"command":"finding","path":["finding"],"kind":"group","summary":"Record one code-review finding as a durable record"},{"command":"finding add","path":["finding","add"],"kind":"command","summary":"Record one code-review finding (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding close","path":["finding","close"],"kind":"command","summary":"Move an already-committed finding's disposition (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding list","path":["finding","list"],"kind":"command","summary":"List a change's committed findings at their latest version: round, seq, severity, disposition, reviewer and summary","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"format","path":["format"],"kind":"command","summary":"Validate a spec/artifact corpus against canon's format","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"gate","path":["gate"],"kind":"group","summary":"Run evidence gates, promote staged records, install hooks"},{"command":"gate check","path":["gate","check"],"kind":"command","summary":"Run the coverage/ledger/staleness/trust checks (0 clean, 1 red, 2 usage)","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"gate install-hooks","path":["gate","install-hooks"],"kind":"command","summary":"Install the gate hook into .claude/settings.json / .codex/hooks.json","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"gate promote","path":["gate","promote"],"kind":"command","summary":"Promote staged records (evidence, findings, divergences) to the committed ledger","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"ingest","path":["ingest"],"kind":"group","summary":"Import agent sessions, records, and plans into canon's store"},{"command":"ingest plans","path":["ingest","plans"],"kind":"command","summary":"Import plans as Change/Task records: canon's own .canon/changes, then the configured external sources (openspec, superpowers)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"ingest records","path":["ingest","records"],"kind":"command","summary":"Import review/divergence/task/handoff records and derive verdicts","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"ingest sessions","path":["ingest","sessions"],"kind":"command","summary":"Import agent CLI session transcripts (omp/pi, Claude Code, Codex, Hermes)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"init","path":["init"],"kind":"command","summary":"Set up canon in a repo (canon.yaml, a starter policy, the AGENTS.md block, a plans home)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"inventory","path":["inventory"],"kind":"group","summary":"Index a validated .feature corpus into the scenario ledger"},{"command":"inventory sync","path":["inventory","sync"],"kind":"command","summary":"Validate each spec root, then materialize scenario index records","effect":"write","x-canon":{"roles":["implementer","orchestrator"]}},{"command":"ledger","path":["ledger"],"kind":"group","summary":"Keep the ledger to the current version of each record"},{"command":"ledger compact","path":["ledger","compact"],"kind":"command","summary":"Move superseded versions of every record out of the ledger into the archive","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"migrate","path":["migrate"],"kind":"command","summary":"Bring a repo from an earlier canon up to date: the 0.17 layout (specs, changes, approvals, skills, .gitignore), the 0.28 hooks, scripts and skill stub (backed up under .canon/migrate-backup/), the 0.23 latest-only ledger (superseded versions to .canon/archive) and 0.23 review pins","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"plugin","path":["plugin"],"kind":"group","summary":"Sync plugin overlay records onto the ledger"},{"command":"plugin sync","path":["plugin","sync"],"kind":"command","summary":"Validate and write a plugin's overlay records","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"policy","path":["policy"],"kind":"group","summary":"Record who approved the gate's policy (.canon/policy.yaml) and which bytes"},{"command":"policy approve","path":["policy","approve"],"kind":"command","summary":"Approve the current .canon/policy.yaml (written directly; nothing to promote)","effect":"write","x-canon":{"roles":[]}},{"command":"policy show","path":["policy","show"],"kind":"command","summary":"Show the policy's digest and its approval (who, when, which bytes)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"prompt","path":["prompt"],"kind":"group","summary":"Register and select versioned prompt bundles"},{"command":"prompt add","path":["prompt","add"],"kind":"command","summary":"Add a prompt bundle from a repository-local JSON manifest","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"prompt show","path":["prompt","show"],"kind":"command","summary":"Select a registered prompt bundle version","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"purge","path":["purge"],"kind":"command","summary":"Remove allowlisted records older than a cutoff: the bare run previews the removal set and its planDigest, `--commit --plan-digest <DIGEST>` deletes it","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"query","path":["query"],"kind":"command","summary":"Read stored records across every storage tier","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"regime","path":["regime"],"kind":"group","summary":"Build a canonical regime key for hook scripts"},{"command":"regime show","path":["regime","show"],"kind":"command","summary":"Build a canonical regime key for hook scripts","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"report","path":["report"],"kind":"group","summary":"Build, check, or snapshot the status report"},{"command":"report build","path":["report","build"],"kind":"command","summary":"Write the status report (.canon/REPORT.md)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"report check","path":["report","check"],"kind":"command","summary":"Byte-diff .canon/REPORT.md against a fresh build (0 fresh, 1 missing or drifted); writes nothing","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"report snapshot","path":["report","snapshot"],"kind":"command","summary":"Export the panel marts to <DIR>/*.parquet plus manifest.json","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"retrieve","path":["retrieve"],"kind":"command","summary":"Fetch role-scoped strategy guidance","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"review","path":["review"],"kind":"group","summary":"Record an attributed review verdict"},{"command":"review change","path":["review","change"],"kind":"command","summary":"Write one attributed Review record for a chore change directly to the ledger (exactly one provenance ref required). The review signs the chore's invariants and checks against the diff and pins the change's brief; an edit to the brief stales it. A chore needs exactly this one review before `subject move --to shipped`","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"review scenario","path":["review","scenario"],"kind":"command","summary":"Write one attributed Review record per scenario directly to the ledger, nothing to promote (exactly one provenance ref required). A review pins the scenario's digest and what its latest evidence says (verdict and checks); it counts only while both are unchanged. Each scenario must be indexed, or nothing is written (exit 2)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"scenario","path":["scenario"],"kind":"group","summary":"Add a tagged scenario to a .feature spec file"},{"command":"scenario new","path":["scenario","new"],"kind":"command","summary":"Append a tagged scenario stub to its .feature file (created if missing); many at once with `--input`","effect":"write","x-canon":{"roles":["planner","implementer"]}},{"command":"schema","path":["schema"],"kind":"command","summary":"Describe canon's own commands: list them, or show one command's arguments, options, effect and exit codes","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"search","path":["search"],"kind":"command","summary":"Search records, brief sections and scenario text, with each hit's neighbors in the record graph","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"selftest","path":["selftest"],"kind":"command","summary":"Run canon's built-in fixture self-tests","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"skills","path":["skills"],"kind":"group","summary":"Install canon's agent guides into a repo"},{"command":"skills check","path":["skills","check"],"kind":"command","summary":"Check canonical projections without writing; exit 1 on drift, a legacy remnant, or a lock another canon version wrote","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"skills doctor","path":["skills","doctor"],"kind":"command","summary":"Print diagnostics for canonical projections, the install lock's canon version, legacy remnants, canon projections for a provider that is not selected, and other skills whose description claims build work; reports only, never edits","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"skills install","path":["skills","install"],"kind":"command","summary":"Install the canonical `canon` bundle or legacy developer skills","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"skills show","path":["skills","show"],"kind":"command","summary":"Print a guide built into this binary (markdown on stdout); the installed SKILL.md is a stub that points here","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"status","path":["status"],"kind":"command","summary":"Show where this repo stands: subjects by status, their gaps, and the next commands","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"strategy","path":["strategy"],"kind":"group","summary":"Promote a proven strategy into the git-tracked tier"},{"command":"strategy approval-payload","path":["strategy","approval-payload"],"kind":"command","summary":"The unsigned approval payload bytes an external signer signs (a read: identical arguments give identical bytes)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"strategy promote","path":["strategy","promote"],"kind":"command","summary":"Promote a strategy after paired evaluation and signed approval","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"strategy rollback","path":["strategy","rollback"],"kind":"command","summary":"Disable an active strategy with durable rollback provenance","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"subject","path":["subject"],"kind":"group","summary":"Create and manage subjects (durable product units)"},{"command":"subject adopt","path":["subject","adopt"],"kind":"command","summary":"Link an imported plan change to a subject (adopting it under another subject adds that subject; a change may belong to several)","effect":"write","x-canon":{"roles":["planner","orchestrator"]}},{"command":"subject move","path":["subject","move"],"kind":"command","summary":"Move a subject to another lifecycle state (shipping is evidence-gated; with spec_coverage.require_review, entering its scope is review-gated; shipped → verifying reopens with --reason)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"subject new","path":["subject","new"],"kind":"command","summary":"Author a new subject at status `proposed`","effect":"write","x-canon":{"roles":["planner","orchestrator"]}},{"command":"subject show","path":["subject","show"],"kind":"command","summary":"Show a subject (read-only)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"subject unadopt","path":["subject","unadopt"],"kind":"command","summary":"Take a change back out of a subject (the mirror of adopt; refused for a change whose brief is approved)","effect":"write","x-canon":{"roles":["planner","orchestrator"]}},{"command":"task","path":["task"],"kind":"group","summary":"Flip a plan task's checkbox once committed evidence supports it"},{"command":"task done","path":["task","done"],"kind":"command","summary":"Flip one task checkbox, gated on real evidence (fails closed)","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"tier","path":["tier"],"kind":"group","summary":"Age records between storage tiers"},{"command":"tier age","path":["tier","age"],"kind":"command","summary":"Apply canon.yaml aging rules, moving old records to their destination tier","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"trace","path":["trace"],"kind":"command","summary":"Follow a finding's review loop in time order: review, finding, fix, re-review, evidence","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}}]},"meta":{"command":"schema","schemaVersion":"1.2","tool":"canon","toolVersion":"0.34.0","contract":"atip/1","contractVersion":"1.2"}}
