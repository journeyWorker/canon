{"ok":true,"data":{"kind":"tree","level":"L2","options":[{"name":"repo","valueName":"DIR","valueType":"path","defaultNote":"the nearest ancestor directory holding a canon.yaml","flagOnly":true,"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)"},{"name":"as","valueName":"ROLE","valueType":"enum","possibleValues":["planner","implementer","reviewer","orchestrator"],"env":"CANON_ROLE","flagOnly":true,"help":"The role you act as: planner, implementer, reviewer or orchestrator. Overrides `CANON_ROLE`. `schema` and `context` list only the role's commands, `status` keeps its steps, and `--role` on `evidence add` / `evidence audit` / `review scenario` / `review change` is this role unless given"},{"name":"dry-run","valueType":"switch","help":"Validate fully and report what would be written, without writing anything"},{"name":"manifest","valueName":"FILE","valueType":"path","required":true,"help":"Repository-relative input manifest"},{"name":"session","valueName":"SESSION_ID","domain":{"pattern":"^[^\\p{Cc}\\p{White_Space}]([^\\p{Cc}]*[^\\p{Cc}\\p{White_Space}])?$"},"help":"The acting session (recorded as actor.session_id); optional"},{"name":"project","valueName":"PROJECT_ID","domain":{"pattern":"^[a-z0-9][a-z0-9-]*$"},"help":"Spec corpus id of the scenarios. Required only when canon.yaml configures more than one spec root"},{"name":"actor","valueName":"ACTOR_ID","required":true,"help":"The reviewer recording this (recorded as the divergence's reviewer and actor)"},{"name":"approver","valueName":"NAME","help":"With --relayed-via, who the human is"},{"name":"note","valueName":"TEXT","help":"With --relayed-via, the human's answer as they gave it"},{"name":"rev","default":"HEAD","help":"The commit this record is about: any git revision (`HEAD~1`, a branch, a tag, a short sha); the full sha is recorded with the code tree it saw. The default HEAD records the working tree as it stands (uncommitted code included), and a commit made from it has the same code tree. Outside git, or with no commit, the command refuses (COMMIT_REQUIRED)"},{"name":"round","valueName":"N","valueType":"integer","default":1,"domain":{"maximum":4294967295,"minimum":0},"help":"The review round this version belongs to (1-based)"},{"name":"detail","valueName":"TEXT","help":"Free-text detail recorded on the version (optional)"},{"name":"role","defaultNote":"the role declared with --as or CANON_ROLE","env":"CANON_ROLE","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"The role this record is attributed to (default: the role declared with --as / CANON_ROLE)"},{"name":"promote","valueType":"switch","defaultNote":"on under canon.yaml `write: { promote: auto }`","help":"Promote the record this run staged, in the same run; records others staged stay staged (the default under canon.yaml `write: { promote: auto }`)"},{"name":"no-promote","valueType":"switch","help":"Keep this write staged even under canon.yaml `write: { promote: auto }`"},{"name":"limit","valueName":"N","valueType":"integer","default":100,"flagOnly":true,"domain":{"minimum":1},"help":"Return at most this many records per page"},{"name":"cursor","flagOnly":true,"help":"Resume after the last record of the previous page (the `nextCursor` it reported)"},{"name":"all","valueType":"switch","flagOnly":true,"help":"Return every record from the cursor on, not one page"},{"name":"command-result","valueName":"TEXT","help":"The real captured output backing --summary (requires --summary; scanned for fabrication markers)"},{"name":"run","valueName":"RUN_ID","domain":{"pattern":"^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$"},"help":"RunId (ULID) of the run that produced this evidence"},{"name":"report","valueName":"FORMAT:PATH","repeatable":true,"domain":{"pattern":"^(junit|cucumber|swift-testing):[^\u0000]+$"},"help":"EXPERIMENTAL: bind and parse a test report, `junit:<path>`, `cucumber:<path>` or `swift-testing:<path>`; repeatable"},{"name":"max-artifact-mib","valueName":"N","valueType":"integer","default":25,"domain":{"minimum":1},"help":"Per-file size limit for the artifact store (.canon/artifacts/sha256/), in MiB; a larger bound file is refused"},{"name":"override-reason","valueName":"TEXT","domain":{"pattern":"^[\\P{White_Space}\\p{Zs}\\t]*\\P{White_Space}[\\P{White_Space}\\p{Zs}\\t]*$"},"help":"Attest anyway while a subject this record attests for has a brief awaiting the human's answer (one line, recorded on the record with --actor)"},{"name":"approval-at","valueName":"TIMESTAMP","required":true,"domain":{"pattern":"^(\\p{White_Space}*[-+]?[0-9]+-\\p{White_Space}*[0-9]{1,2}-\\p{White_Space}*[0-9]{1,2}|[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[-+−][0-9]{2}:[0-9]{2}))$"},"help":"The approval time that is signed into the payload: RFC3339, or YYYY-MM-DD (UTC midnight)"},{"name":"resolution-rev","valueName":"REV","defaultNote":"HEAD when --disposition is fixed","help":"The commit that closed it, any git revision (resolved to the full sha, with the code tree it saw). Permitted only with --disposition fixed, where it defaults to HEAD. Existence only; canon never reads the commit's message or diff"},{"name":"watch","valueType":"switch","help":"Keep polling instead of exiting after one pass"},{"name":"interval-secs","valueName":"N","valueType":"integer","default":30,"domain":{"minimum":0},"help":"Seconds between polls"},{"name":"spec-root","valueName":"DIR","valueType":"path","help":"Sync exactly one ad hoc root, overriding canon.yaml's specs.roots[]"},{"name":"upstream-ref","valueName":"TEXT","help":"Provenance ref (mutually exclusive with --original-spec-ref; exactly one required)"},{"name":"original-spec-ref","valueName":"TEXT","help":"Provenance ref (mutually exclusive with --upstream-ref; exactly one required)"},{"name":"review-outcome","valueType":"enum","possibleValues":["signed","indeterminate","unavailable"],"default":"signed","help":"How the reviewer's run ended: signed (an approval), indeterminate (ran, reached no verdict) or unavailable (could not run). Only signed counts; the others are recorded as review gaps"},{"name":"reviewer-provider","valueName":"NAME","domain":{"pattern":"^[^\\p{Cc}\\p{White_Space}]([^\\p{Cc}]*[^\\p{Cc}\\p{White_Space}])?$"},"help":"The reviewer runtime's provider (e.g. anthropic, openai)"},{"name":"reviewer-model","valueName":"NAME","domain":{"pattern":"^[^\\p{Cc}\\p{White_Space}]([^\\p{Cc}]*[^\\p{Cc}\\p{White_Space}])?$"},"help":"The reviewer runtime's model id"},{"name":"reviewer-harness","valueName":"NAME","domain":{"pattern":"^[^\\p{Cc}\\p{White_Space}]([^\\p{Cc}]*[^\\p{Cc}\\p{White_Space}])?$"},"help":"The harness that ran the reviewer (e.g. omp, codex, claude)"},{"name":"artifact","valueName":"PATH","valueType":"path","repeatable":true,"help":"A file the reviewer looked at (screenshot, recording); repeatable; must be inside the repo. Stored in .canon/artifacts/sha256/ and re-hashed by `canon gate check`"},{"name":"skills-source","valueName":"DIR","valueType":"path","defaultNote":"CANON_SKILLS_SOURCE, else canon/skills","env":"CANON_SKILLS_SOURCE","help":"Source directory; defaults to CANON_SKILLS_SOURCE or canon/skills"},{"name":"providers","valueName":"LIST","defaultNote":"the providers `skills install` would use","domain":{"pattern":"^(\\p{White_Space}*|\\p{White_Space}*[Nn][Oo][Nn][Ee]\\p{White_Space}*|(\\p{White_Space}*,)*\\p{White_Space}*([Cc][Ll][Aa][Uu][Dd][Ee]|[Cc][Oo][Dd][Ee][Xx]|[Oo][Mm][Pp]|[Pp][Ii])\\p{White_Space}*(,\\p{White_Space}*(([Cc][Ll][Aa][Uu][Dd][Ee]|[Cc][Oo][Dd][Ee][Xx]|[Oo][Mm][Pp]|[Pp][Ii])\\p{White_Space}*)?)*)$"},"help":"Providers to inspect (`claude`, `codex`, `omp`, `pi`, or a comma-separated list). Omitted: as for install"}],"commands":[{"command":"adapter","kind":"group","summary":"Validate a provider-neutral adapter response without executing a provider"},{"command":"adapter authorize","summary":"Authorize declared capabilities against repository policy (preflight only)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"adapter validate","summary":"Read and validate one provider-neutral response envelope","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"artifacts","kind":"group","summary":"Check or move the evidence artifact store (local, or an object-store tier)"},{"command":"artifacts move","summary":"Move the local artifact blobs to an object-store tier, verify them, and remove the local copies","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"artifacts store","summary":"Store the bound files of existing evidence records and current reviews in the artifact store (.canon/artifacts/sha256/)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"artifacts verify","summary":"Check that the artifact store holds every file the latest evidence and current reviews bind (--full re-hashes the stored bytes)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"brief","kind":"group","summary":"Check a change's brief (PRD format) and see the next steps; never edits"},{"command":"brief approve","summary":"Record the human's approval of the brief, bound to its text; refused while `brief check` has blockers","effect":"write","x-canon":{"roles":[]}},{"command":"brief check","summary":"Read the brief against the rules: blocker and advisory findings (exit 0 clean, 1 blockers, 2 refused)","effect":"read","x-canon":{"roles":["planner","reviewer"]}},{"command":"brief show","summary":"Show where the change stands and the next one to three steps; never edits","effect":"read","x-canon":{"roles":["planner","reviewer"]}},{"command":"change","kind":"group","summary":"Write a plan change (.canon/changes/<slug>/brief.md) and adopt it into a subject"},{"command":"change new","summary":"Write .canon/changes/<slug>/brief.md, import it, and adopt it into a subject","effect":"write","x-canon":{"roles":["planner"]}},{"command":"completion","summary":"Write the shell completion script for canon (bash, zsh or fish)","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"context","summary":"Show what you can author here: record kinds, fields, enums, policies","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"context-pack","kind":"group","summary":"Create, inspect, and verify reproducible context packs"},{"command":"context-pack add","summary":"Create an immutable context pack from a repository-local JSON manifest","effect":"write","x-canon":{"roles":["orchestrator","implementer"]}},{"command":"context-pack show","summary":"Show a context pack after verifying its manifest and content objects","effect":"read","x-canon":{"roles":["orchestrator","implementer"]}},{"command":"context-pack verify","summary":"Verify a context pack's manifest and immutable content objects","effect":"read","x-canon":{"roles":["orchestrator","implementer"]}},{"command":"dashboard","summary":"Serve the local status dashboard","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"demo","kind":"group","summary":"Try the evidence loop end-to-end in a throwaway demo repo"},{"command":"demo init","summary":"Scaffold the demo repo (gate starts RED)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"demo review","summary":"Record the missing reviewer evidence (gate turns GREEN)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"dispatch","kind":"group","summary":"Begin an agent run with retrieved guidance recorded"},{"command":"dispatch begin","summary":"Mint a Run manifest with retrieved guidance and context/policy lineage","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"dispatch diff","summary":"Diff the declared plan DAG against the observed execution graph","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"dispatch end","summary":"Close a dispatched run with a terminal status and an ended_at","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"divergence","kind":"group","summary":"Stage, promote, resolve, and inspect spec divergences"},{"command":"divergence accept","summary":"Accept a divergent scenario as a tracked known gap (a reviewer step): its latest evidence must be divergent and not the accepting actor's or session's. The acceptance pins that evidence, so new evidence ends it, and lapses at --expiry; until then the ship guard counts the cell as covered while `status` and `gate check` list it as `accepted-divergence`","effect":"write","x-canon":{"roles":[]}},{"command":"divergence add","summary":"Add a divergence candidate, staged with no run_seq yet (commit it with `canon gate promote --kind divergence`, or in the same run with --promote / `write: { promote: auto }`)","effect":"write","x-canon":{"roles":["implementer","reviewer"]}},{"command":"divergence defer","summary":"Directly record a deferred divergence (requires --reason/--expiry)","effect":"write","x-canon":{"roles":["implementer","reviewer"]}},{"command":"divergence list","summary":"List the current divergence burn-down state","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"divergence resolve","summary":"Directly record a resolved divergence","effect":"write","x-canon":{"roles":["implementer","reviewer"]}},{"command":"evidence","kind":"group","summary":"Author a staged, attributed evidence attestation for a plan task"},{"command":"evidence add","summary":"Record one attributed EvidenceRecord for a task or scenario (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"evidence approval-payload","summary":"Emit exact bytes for external `ssh-keygen -Y sign -n canon-approval-v1`","effect":"read","x-canon":{"roles":["implementer","orchestrator"]}},{"command":"evidence audit","summary":"Record an external evaluator's re-audit of one scenario (class `audit`; the verdict follows --audit-result; canon never runs the evaluator)","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"export","summary":"Export a redacted retention manifest without deleting records","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"feature","kind":"group","summary":"Scaffold a new .feature spec file"},{"command":"feature new","summary":"Create a fresh .feature file for a new area.surface","effect":"write","x-canon":{"roles":["planner","implementer"]}},{"command":"finding","kind":"group","summary":"Record one code-review finding as a durable record"},{"command":"finding add","summary":"Record one code-review finding (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding close","summary":"Move an already-committed finding's disposition (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"finding list","summary":"List a change's committed findings at their latest version: round, seq, severity, disposition, reviewer and summary","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"format","summary":"Validate a spec/artifact corpus against canon's format","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"gate","kind":"group","summary":"Run evidence gates, promote staged records, install hooks"},{"command":"gate check","summary":"Run the coverage/ledger/staleness/trust checks (0 clean, 1 red, 2 usage)","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"gate install-hooks","summary":"Install the gate hook into .claude/settings.json / .codex/hooks.json","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"gate promote","summary":"Promote staged records (evidence, findings, divergences) to the committed ledger","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"ingest","kind":"group","summary":"Import agent sessions, records, and plans into canon's store"},{"command":"ingest plans","summary":"Import plans as Change/Task records: canon's own .canon/changes, then the configured external sources (openspec, superpowers)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"ingest records","summary":"Import review/divergence/task/handoff records and derive verdicts","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"ingest sessions","summary":"Import agent CLI session transcripts (omp/pi, Claude Code, Codex, Hermes)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"init","summary":"Set up canon in a repo (canon.yaml, a starter policy, the AGENTS.md block, a plans home)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"inventory","kind":"group","summary":"Index a validated .feature corpus into the scenario ledger"},{"command":"inventory sync","summary":"Validate each spec root, then materialize scenario index records","effect":"write","x-canon":{"roles":["implementer","orchestrator"]}},{"command":"ledger","kind":"group","summary":"Keep the ledger to the current version of each record"},{"command":"ledger compact","summary":"Move superseded versions of every record out of the ledger into the archive","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"migrate","summary":"Bring a repo from an earlier canon up to date: the 0.17 layout (specs, changes, approvals, skills, .gitignore), the 0.28 hooks, scripts and skill stub (backed up under .canon/migrate-backup/), the 0.23 latest-only ledger (superseded versions to .canon/archive) and 0.23 review pins","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"plugin","kind":"group","summary":"Sync plugin overlay records onto the ledger"},{"command":"plugin sync","summary":"Validate and write a plugin's overlay records","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"policy","kind":"group","summary":"Record who approved the gate's policy (.canon/policy.yaml) and which bytes"},{"command":"policy approve","summary":"Approve the current .canon/policy.yaml (written directly; nothing to promote)","effect":"write","x-canon":{"roles":[]}},{"command":"policy show","summary":"Show the policy's digest and its approval (who, when, which bytes)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"prompt","kind":"group","summary":"Register and select versioned prompt bundles"},{"command":"prompt add","summary":"Add a prompt bundle from a repository-local JSON manifest","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"prompt show","summary":"Select a registered prompt bundle version","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"purge","summary":"Remove allowlisted records older than a cutoff: the bare run previews the removal set and its planDigest, `--commit --plan-digest <PLAN_DIGEST>` deletes it","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"query","summary":"Read stored records across every storage tier","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"regime","kind":"group","summary":"Build a canonical regime key for hook scripts"},{"command":"regime show","summary":"Build a canonical regime key for hook scripts","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"report","kind":"group","summary":"Build, check, or snapshot the status report"},{"command":"report build","summary":"Write the status report (.canon/REPORT.md)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"report check","summary":"Byte-diff .canon/REPORT.md against a fresh build (0 fresh, 1 missing or drifted); writes nothing","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"report snapshot","summary":"Export the panel marts to <DIR>/*.parquet plus manifest.json","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"retrieve","summary":"Fetch role-scoped strategy guidance","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"review","kind":"group","summary":"Record an attributed review verdict"},{"command":"review change","summary":"Write one attributed Review record for a chore change directly to the ledger (exactly one provenance ref required). The review signs the chore's invariants and checks against the diff and pins the change's brief; an edit to the brief stales it. A chore needs exactly this one review before `subject move --to shipped`","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"review scenario","summary":"Write one attributed Review record per scenario directly to the ledger, nothing to promote (exactly one provenance ref required). A review pins the scenario's digest and what its latest evidence says (verdict and checks); it counts only while both are unchanged. Each scenario must be indexed, or nothing is written (exit 2)","effect":"write","x-canon":{"roles":["reviewer"]}},{"command":"scenario","kind":"group","summary":"Add a tagged scenario to a .feature spec file"},{"command":"scenario new","summary":"Append a tagged scenario stub to its .feature file (created if missing); many at once with `--input`","effect":"write","x-canon":{"roles":["planner","implementer"]}},{"command":"schema","summary":"Describe canon's own commands: list them, or show one command's arguments, options, effect and exit codes","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"search","summary":"Search records, brief sections and scenario text, with each hit's neighbors in the record graph","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"selftest","summary":"Run canon's built-in fixture self-tests","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"skills","kind":"group","summary":"Install canon's agent guides into a repo"},{"command":"skills check","summary":"Check canonical projections without writing; exit 1 on drift, a legacy remnant, or a lock another canon version wrote","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"skills doctor","summary":"Print diagnostics for canonical projections, the install lock's canon version, legacy remnants, canon projections for a provider that is not selected, and other skills whose description claims build work; reports only, never edits","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"skills install","summary":"Install the canonical `canon` bundle or legacy developer skills","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"skills show","summary":"Print a guide built into this binary (markdown on stdout); the installed SKILL.md is a stub that points here","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"status","summary":"Show where this repo stands: subjects by status, their gaps, and the next commands","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},{"command":"strategy","kind":"group","summary":"Promote a proven strategy into the git-tracked tier"},{"command":"strategy approval-payload","summary":"The unsigned approval payload bytes an external signer signs (a read: identical arguments give identical bytes)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"strategy promote","summary":"Promote a strategy after paired evaluation and signed approval","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"strategy rollback","summary":"Disable an active strategy with durable rollback provenance","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"subject","kind":"group","summary":"Create and manage subjects (durable product units)"},{"command":"subject adopt","summary":"Link an imported plan change to a subject (adopting it under another subject adds that subject; a change may belong to several)","effect":"write","x-canon":{"roles":["planner","orchestrator"]}},{"command":"subject move","summary":"Move a subject to another lifecycle state (shipping is evidence-gated; with spec_coverage.require_review, entering its scope is review-gated; shipped → verifying reopens with --reason)","effect":"write","x-canon":{"roles":["orchestrator"]}},{"command":"subject new","summary":"Author a new subject at status `proposed`","effect":"write","x-canon":{"roles":["planner","orchestrator"]}},{"command":"subject show","summary":"Show a subject (read-only)","effect":"read","x-canon":{"roles":["orchestrator"]}},{"command":"subject unadopt","summary":"Take a change back out of a subject (the mirror of adopt; refused for a change whose brief is approved)","effect":"write","x-canon":{"roles":["planner","orchestrator"]}},{"command":"task","kind":"group","summary":"Flip a plan task's checkbox once committed evidence supports it"},{"command":"task done","summary":"Flip one task checkbox, gated on real evidence (fails closed)","effect":"write","x-canon":{"roles":["implementer"]}},{"command":"tier","kind":"group","summary":"Age records between storage tiers"},{"command":"tier age","summary":"Apply canon.yaml aging rules, moving old records to their destination tier","effect":"destructive","x-canon":{"roles":["orchestrator"]}},{"command":"trace","summary":"Follow a finding's review loop in time order: review, finding, fix, re-review, evidence","effect":"read","x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}}]},"meta":{"command":"schema","schemaVersion":"1.5","tool":"canon","toolVersion":"0.36.0","contract":"atip/1","contractVersion":"1.5"}}
