{"ok":true,"data":{"kind":"command","command":"finding close","path":["finding","close"],"summary":"Move an already-committed finding's disposition (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","idempotency":"replay-safe","operands":[{"name":"change","valueName":"CHANGE_ID","valueType":"string","required":true,"variadic":false,"default":null,"domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"The change under review — first component of the natural key"}],"options":[{"name":"round","valueName":"N","valueType":"integer","required":true,"repeatable":false,"default":null,"domain":{"maximum":4294967295,"minimum":1},"help":"Which review round raised it (1-based)"},{"name":"seq","valueName":"N","valueType":"integer","required":true,"repeatable":false,"default":null,"domain":{"maximum":4294967295,"minimum":1},"help":"The finding's index within the round (1-based)"},{"name":"disposition","valueName":"DISPOSITION","valueType":"enum","possibleValues":["open","fixed","rejected","deferred"],"required":true,"repeatable":false,"default":null,"help":"Where it lands: fixed / rejected / deferred / open (reopening is a real transition). fixed records --resolution-rev, default HEAD, and only fixed may carry one"},{"name":"resolution-rev","valueName":"REV","valueType":"string","required":false,"repeatable":false,"default":null,"defaultNote":"HEAD when --disposition is fixed","help":"The commit that closed it, any git revision (resolved to the full sha, with the code tree it saw). Permitted only with --disposition fixed, where it defaults to HEAD. Existence only; canon never reads the commit's message or diff"},{"name":"reason","valueName":"TEXT","valueType":"string","required":false,"repeatable":false,"default":null,"domain":{"pattern":"^[^\\n\\r\u000b\f\\p{Zl}\\p{Zp}]*[^ \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　][^\\n\\r\u000b\f\\p{Zl}\\p{Zp}]*$"},"help":"Why it was closed, one line. Required for rejected and deferred, optional for fixed and open; stored on the closing version and shown by `finding list`"},{"name":"actor","valueName":"ACTOR_ID","valueType":"string","required":false,"repeatable":false,"default":"canon","help":"The actor recorded as authoring the TRANSITION — not the original finding's author, which is preserved on the record this supersedes"},{"name":"role","valueName":"ROLE","valueType":"string","required":false,"repeatable":false,"default":"reviewer","env":"CANON_ROLE","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"Attribution only — no partition key derives from it"},{"name":"session","valueName":"SESSION_ID","valueType":"string","required":false,"repeatable":false,"default":null,"domain":{"pattern":"^[^\\p{Cc} \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　]([^\\p{Cc}]*[^\\p{Cc} \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　])?$"},"help":"The session that authored the TRANSITION (recorded as actor.session_id)"},{"name":"promote","valueType":"switch","required":false,"repeatable":false,"default":false,"defaultNote":"on under canon.yaml `write: { promote: auto }`","help":"Promote the record this run staged, in the same run; records others staged stay staged (the default under canon.yaml `write: { promote: auto }`)"},{"name":"no-promote","valueType":"switch","required":false,"repeatable":false,"default":false,"help":"Keep this write staged even under canon.yaml `write: { promote: auto }`"},{"name":"repo","valueName":"DIR","valueType":"path","required":false,"repeatable":false,"default":null,"defaultNote":"the nearest ancestor directory holding a canon.yaml","flagOnly":true,"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)"},{"name":"json","valueType":"switch","required":false,"repeatable":false,"default":false,"flagOnly":true,"help":"Output JSON instead of the human-readable form"},{"name":"input","valueName":"JSON|FILE|-","valueType":"string","required":false,"repeatable":false,"default":null,"flagOnly":true,"help":"The arguments as JSON: an object (one run) or an array / NDJSON file or `-` (a batch); keys are the option names in camelCase, `operands` an array"},{"name":"as","valueName":"ROLE","valueType":"enum","possibleValues":["planner","implementer","reviewer","orchestrator"],"required":false,"repeatable":false,"default":null,"env":"CANON_ROLE","flagOnly":true,"help":"The role you act as: planner, implementer, reviewer or orchestrator. Overrides `CANON_ROLE`. `schema` and `context` list only the role's commands, `status` keeps its steps, and `--role` on `evidence add` / `evidence audit` / `review scenario` / `review change` is this role unless given"}],"constraints":[{"rule":"atMostOne","names":["promote","no-promote"]},{"rule":"requires","if":{"name":"disposition","in":["rejected","deferred"]},"then":["reason"],"code":"FINDING_REASON_REQUIRED","help":"A rejected or deferred finding records why."},{"rule":"forbids","if":{"name":"disposition","in":["open","rejected","deferred"]},"then":["resolution-rev"],"code":"FINDING_RESOLUTION_REV_UNEXPECTED","help":"Only a `fixed` finding was closed by a commit."}],"errors":["BATCH_INCOMPLETE","CONFIG_MISSING","CONFIG_UNREADABLE","FINDING_INTRODUCED_REQUIRED","FINDING_INVALID_ARGUMENT","FINDING_NOT_FOUND","FINDING_REASON_REQUIRED","FINDING_RESOLUTION_REV_UNEXPECTED","FINDING_STAGED","INPUT_CONFLICT","INPUT_INVALID","INPUT_TOO_LARGE","INTERNAL","NO_COMMIT","OLD_LAYOUT","PROMOTE_FAILED","REPO_UNREADABLE","REPO_WRITE_BUSY","UNKNOWN_ROLE","USAGE","WRITE_FAILED","WRITE_UNAVAILABLE"],"outputs":[{"kind":"report","schemaRef":"#/schemas/FindingCloseReport","schemaVersion":"1.1"},{"kind":"report","schemaRef":"#/schemas/BatchFindingCloseReport","schemaVersion":"1.1","batch":true,"when":"--input is an array or NDJSON"}],"input":{"option":"--input","schemaRef":"#/schemas/FindingCloseInput","argumentsRef":"#/schemas/FindingCloseArguments","batch":true,"maxBytes":8388608,"maxItems":10000,"example":{"disposition":"rejected","operands":["add-login"],"reason":"works as designed","round":1,"seq":1}},"examples":["canon finding close add-login --round 1 --seq 1 --disposition rejected --reason \"works as designed\" --json"],"schemas":{"BatchFindingCloseReport":{"description":"`Batch<Name>Report`: the `data` of a leaf run with a JSON array or NDJSON as `--input`.\n`R` is the leaf's ordinary report; the binary itself carries each element's report as JSON.","properties":{"items":{"items":{"$ref":"#/schemas/BatchItem"},"type":"array"},"nextOmitted":{"description":"How many further `meta.next` steps were left out past the limit","minimum":1,"type":"integer"},"unchanged":{"description":"true when a repeat found its work already done with identical content and wrote nothing; absent otherwise","type":"boolean"},"waitingOn":{"additionalProperties":{"minimum":0,"type":"integer"},"description":"With a declared role: how many steps each other owner holds (`human` for the steps only the human takes)","type":"object"}},"required":["items"],"title":"BatchReport","type":"object"},"BatchFindingCloseReportFindingCloseReport":{"description":"`canon finding close`: the transition staged or committed, or a no-op.","properties":{"changeId":{"type":"string"},"committed":{"type":["string","null"]},"disposition":{"type":"string"},"from":{"description":"The disposition it moved from; absent when unchanged.","type":["string","null"]},"round":{"format":"uint32","minimum":0,"type":"integer"},"seq":{"format":"uint32","minimum":0,"type":"integer"},"staged":{"type":["string","null"]}},"required":["changeId","round","seq","disposition"],"type":"object"},"BatchItem":{"description":"One element of a batch, in input order.","properties":{"data":{"anyOf":[{"$ref":"#/schemas/BatchFindingCloseReportFindingCloseReport"},{"type":"null"}],"description":"The element's ordinary report: a `written` or `unchanged` element has one, a `failed` or `skipped` one has none."},"error":{"anyOf":[{"$ref":"#/schemas/ErrorBody"},{"type":"null"}],"description":"The element's ordinary error, its `field` a pointer into the batch (`/2/scenario`)."},"index":{"description":"0-based position in the input.","format":"uint","minimum":0,"type":"integer"},"status":{"$ref":"#/schemas/ItemStatus"}},"required":["index","status"],"type":"object"},"ErrorBody":{"description":"The `error` member of a failure envelope. Field order is the document\norder: `code` first. An optional member with no value is left out of the\ndocument, so the body validates against the contract's error schema.","properties":{"code":{"description":"Stable SCREAMING_SNAKE code a caller branches on, registered in the tool's error registry.","type":"string"},"details":{"description":"Every error of an input that yields several, in the order the tool found them (spec 7.1.1); absent for one error.","items":{"$ref":"#/schemas/ErrorDetailBody"},"type":["array","null"]},"expected":{"description":"The valid values of `field`, when it takes a closed set.","items":{"type":"string"},"type":["array","null"]},"field":{"description":"The refused argv name (`--scenario`) or an RFC 6901 JSON pointer into `--input`.","type":["string","null"]},"hint":{"description":"A working invocation or the next step.","type":["string","null"]},"message":{"type":"string"},"reason":{"description":"Which of the situations registered under `code` this is (since 1.1); registered in the code's row.","type":["string","null"]},"received":{"description":"The value that was refused, with secrets redacted; `\"\"` for an empty value the caller sent (1.1).","type":["string","null"]},"retryable":{"description":"True only where running the same command again can succeed; equal to the registry row's.","type":"boolean"},"suggestions":{"description":"The nearest valid commands, options or values.","items":{"type":"string"},"type":"array"}},"required":["code","message","retryable"],"type":"object"},"ErrorDetailBody":{"description":"One item of `details` (spec 7.1.1): the members of [`ErrorBody`] except `retryable` and `details`.","properties":{"code":{"type":"string"},"expected":{"items":{"type":"string"},"type":["array","null"]},"field":{"type":["string","null"]},"hint":{"type":["string","null"]},"message":{"type":"string"},"reason":{"type":["string","null"]},"received":{"type":["string","null"]},"suggestions":{"items":{"type":"string"},"type":"array"}},"required":["code","message"],"type":"object"},"FindingCloseArguments":{"additionalProperties":false,"properties":{"actor":{"description":"The actor recorded as authoring the TRANSITION — not the original finding's author, which is preserved on the record this supersedes","type":"string"},"disposition":{"description":"Where it lands: fixed / rejected / deferred / open (reopening is a real transition). fixed records --resolution-rev, default HEAD, and only fixed may carry one","enum":["open","fixed","rejected","deferred"]},"noPromote":{"description":"Keep this write staged even under canon.yaml `write: { promote: auto }`","type":"boolean"},"operands":{"description":"The change under review — first component of the natural key","items":{"type":"string"},"maxItems":1,"minItems":1,"type":"array"},"promote":{"description":"Promote the record this run staged, in the same run; records others staged stay staged (the default under canon.yaml `write: { promote: auto }`)","type":"boolean"},"reason":{"description":"Why it was closed, one line. Required for rejected and deferred, optional for fixed and open; stored on the closing version and shown by `finding list`","type":"string"},"resolutionRev":{"description":"The commit that closed it, any git revision (resolved to the full sha, with the code tree it saw). Permitted only with --disposition fixed, where it defaults to HEAD. Existence only; canon never reads the commit's message or diff","type":"string"},"role":{"description":"Attribution only — no partition key derives from it","type":"string"},"round":{"description":"Which review round raised it (1-based)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"seq":{"description":"The finding's index within the round (1-based)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"session":{"description":"The session that authored the TRANSITION (recorded as actor.session_id)","type":"string"}},"required":["operands","round","seq","disposition"],"title":"`canon finding close` arguments after the --input document is merged with the command line","type":"object"},"FindingCloseInput":{"additionalProperties":false,"properties":{"actor":{"description":"The actor recorded as authoring the TRANSITION — not the original finding's author, which is preserved on the record this supersedes","type":"string"},"disposition":{"description":"Where it lands: fixed / rejected / deferred / open (reopening is a real transition). fixed records --resolution-rev, default HEAD, and only fixed may carry one","enum":["open","fixed","rejected","deferred"]},"noPromote":{"description":"Keep this write staged even under canon.yaml `write: { promote: auto }`","type":"boolean"},"operands":{"description":"The change under review — first component of the natural key","items":{"type":"string"},"maxItems":1,"minItems":1,"type":"array"},"promote":{"description":"Promote the record this run staged, in the same run; records others staged stay staged (the default under canon.yaml `write: { promote: auto }`)","type":"boolean"},"reason":{"description":"Why it was closed, one line. Required for rejected and deferred, optional for fixed and open; stored on the closing version and shown by `finding list`","type":"string"},"resolutionRev":{"description":"The commit that closed it, any git revision (resolved to the full sha, with the code tree it saw). Permitted only with --disposition fixed, where it defaults to HEAD. Existence only; canon never reads the commit's message or diff","type":"string"},"role":{"description":"Attribution only — no partition key derives from it","type":"string"},"round":{"description":"Which review round raised it (1-based)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"seq":{"description":"The finding's index within the round (1-based)","pattern":"^-?(0|[1-9][0-9]*)$","type":["integer","string"]},"session":{"description":"The session that authored the TRANSITION (recorded as actor.session_id)","type":"string"}},"title":"`canon finding close` --input document","type":"object"},"FindingCloseReport":{"description":"`canon finding close`: the transition staged or committed, or a no-op.","properties":{"changeId":{"type":"string"},"committed":{"type":["string","null"]},"disposition":{"type":"string"},"from":{"description":"The disposition it moved from; absent when unchanged.","type":["string","null"]},"nextOmitted":{"description":"How many further `meta.next` steps were left out past the limit","minimum":1,"type":"integer"},"round":{"format":"uint32","minimum":0,"type":"integer"},"seq":{"format":"uint32","minimum":0,"type":"integer"},"staged":{"type":["string","null"]},"unchanged":{"description":"true when a repeat found its work already done with identical content and wrote nothing; absent otherwise","type":"boolean"},"waitingOn":{"additionalProperties":{"minimum":0,"type":"integer"},"description":"With a declared role: how many steps each other owner holds (`human` for the steps only the human takes)","type":"object"}},"required":["changeId","round","seq","disposition"],"title":"FindingCloseReport","type":"object"},"ItemStatus":{"description":"What happened to one element of a batch.","oneOf":[{"const":"written","description":"The element ran and wrote.","type":"string"},{"const":"unchanged","description":"The element ran and found its record already present with identical content.","type":"string"},{"const":"failed","description":"The element ran and failed; `error` says why.","type":"string"},{"const":"skipped","description":"An earlier element failed, so this one never ran.","type":"string"}]}},"x-canon":{"role