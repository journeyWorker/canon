{"ok":true,"data":{"kind":"command","command":"finding close","summary":"Move an already-committed finding's disposition (promoted in the same run under `write: { promote: auto }` or with --promote; under `write.promote: manual`, commit it with `canon gate promote`)","effect":"write","idempotency":"replay-safe","operands":[{"name":"change","valueName":"CHANGE_ID","required":true,"domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"The change under review — first component of the natural key"}],"options":[{"name":"round","valueName":"N","valueType":"integer","required":true,"domain":{"maximum":4294967295,"minimum":1},"help":"Which review round raised it (1-based)"},{"name":"seq","valueName":"N","valueType":"integer","required":true,"domain":{"maximum":4294967295,"minimum":1},"help":"The finding's index within the round (1-based)"},{"name":"disposition","valueType":"enum","possibleValues":["open","fixed","rejected","deferred"],"required":true,"help":"Where it lands: fixed / rejected / deferred / open (reopening is a real transition). fixed records --resolution-rev, default HEAD, and only fixed may carry one"},"resolution-rev",{"name":"reason","valueName":"TEXT","domain":{"pattern":"^[^\\n\\r\u000b\f\\p{Zl}\\p{Zp}]*[^ \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　][^\\n\\r\u000b\f\\p{Zl}\\p{Zp}]*$"},"help":"Why it was closed, one line. Required for rejected and deferred, optional for fixed and open; stored on the closing version and shown by `finding list`"},{"name":"actor","valueName":"ACTOR_ID","default":"canon","help":"The actor recorded as authoring the TRANSITION — not the original finding's author, which is preserved on the record this supersedes"},{"name":"role","default":"reviewer","env":"CANON_ROLE","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"Attribution only — no partition key derives from it"},{"name":"session","valueName":"SESSION_ID","domain":{"pattern":"^[^\\p{Cc} \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　]([^\\p{Cc}]*[^\\p{Cc} \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　])?$"},"help":"The session that authored the TRANSITION (recorded as actor.session_id)"},"promote","no-promote","repo","as"],"constraints":[{"rule":"atMostOne","names":["promote","no-promote"]},{"rule":"requires","if":{"name":"disposition","in":["rejected","deferred"]},"then":["reason"],"code":"FINDING_REASON_REQUIRED","help":"A rejected or deferred finding records why."},{"rule":"forbids","if":{"name":"disposition","in":["open","rejected","deferred"]},"then":["resolution-rev"],"code":"FINDING_RESOLUTION_REV_CONFLICT","help":"Only a `fixed` finding was closed by a commit."}],"errors":["COMMIT_REQUIRED","CONFIG_DENIED","CONFIG_INVALID","CONFIG_REQUIRED","CONFIG_UNAVAILABLE","FINDING_CONFLICT","FINDING_INCOMPLETE","FINDING_NOT_FOUND","FINDING_RESOLUTION_REV_CONFLICT","LAYOUT_MIGRATION_REQUIRED","PROMOTION_FAILED","REPO_DENIED","REPO_INVALID","REPO_LOCK_UNAVAILABLE","REPO_UNAVAILABLE","ROLE_INVALID","WRITE_DENIED","WRITE_FAILED","WRITE_INVALID"],"outputs":[{"schemaRef":"#/schemas/FindingCloseReport","schemaVersion":"1.1"},{"schemaRef":"#/schemas/BatchFindingCloseReport","schemaVersion":"1.1","batch":true,"when":"--input is an array or NDJSON"}],"input":{"argumentsRef":"#/schemas/FindingCloseArguments","batch":true,"maxBytes":8388608,"maxItems":10000,"example":{"disposition":"rejected","operands":["add-login"],"reason":"works as designed","round":1,"seq":1}},"examples":["canon finding close add-login --round 1 --seq 1 --disposition rejected --reason \"works as designed\" --json"],"x-canon":{"roles":["reviewer"]}},"meta":{"command":"schema","schemaVersion":"1.4","tool":"canon","toolVersion":"0.36.0","contract":"atip/1","contractVersion":"1.4"}}
