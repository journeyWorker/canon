{"ok":true,"data":{"about":"Read stored records across every storage tier","aliases":[],"command":"query","effect":"read","effectNote":"appends one line to .canon/audit/access.jsonl; a refused run writes none","errorCodes":["CONFIG_MISSING","INVALID_CURSOR","QUERY_FAILED","QUERY_INVALID_ARGUMENT","UNKNOWN_FIELD","UNKNOWN_ROLE","USAGE"],"examples":["canon query --kind evidence"],"exits":[{"code":0,"meaning":"success"},{"code":2,"meaning":"refused: CONFIG_MISSING, or an input that is missing, unreadable or invalid; nothing is written"}],"inputs":[],"name":"query","nodeKind":"leaf","operands":[],"options":[{"aliases":[],"default":[],"help":"Record kind to read (e.g. handoff, strategy_item)","kind":"value","name":"kind","possibleValues":["change","task","scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"],"repeatable":false,"required":true,"valueName":"KIND"},{"aliases":[],"default":[],"help":"Only records with at >= <since> (RFC3339/ISO-8601)","kind":"value","name":"since","possibleValues":[],"repeatable":false,"required":false,"valueName":"SINCE"},{"aliases":[],"default":[],"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)","kind":"value","name":"repo","possibleValues":[],"repeatable":false,"required":false,"valueName":"DIR"},{"aliases":[],"default":[],"help":"Output JSON instead of the human-readable form","kind":"flag","name":"json","possibleValues":[],"repeatable":false,"required":false},{"aliases":[],"conflictsWith":["--history"],"default":[],"help":"Project a plugin's overlay fields onto each record (fail-soft)","kind":"value","name":"plugin-id","possibleValues":[],"repeatable":false,"required":false,"valueName":"PLUGIN_ID"},{"aliases":[],"conflictsWith":["--plugin-id"],"default":[],"help":"Every version of the kind, the ledger's and the archive's, oldest first, instead of the current records","kind":"flag","name":"history","possibleValues":[],"repeatable":false,"required":false},{"aliases":[],"default":[],"help":"Scope --kind change/task to one ChangeId (other kinds exit 2)","kind":"value","name":"change-id","possibleValues":[],"repeatable":false,"required":false,"valueName":"CHANGE_ID"},{"aliases":[],"default":[],"help":"Scope --kind change/task by status field (other kinds exit 2)","kind":"value","name":"status","possibleValues":[],"repeatable":false,"required":false,"valueName":"STATUS"},{"aliases":[],"default":[],"help":"Scope --kind subject by domain (other kinds exit 2)","kind":"value","name":"domain","possibleValues":[],"repeatable":false,"required":false,"valueName":"DOMAIN"},{"aliases":[],"default":[],"help":"Permit sensitive query output only when policy explicitly allows it","kind":"flag","name":"include-sensitive","possibleValues":[],"repeatable":false,"required":false},{"aliases":[],"conflictsWith":["--all"],"default":[],"help":"Return at most this many records (default 100)","kind":"value","name":"limit","possibleValues":[],"repeatable":false,"required":false,"valueName":"LIMIT"},{"aliases":[],"default":[],"help":"Resume after the last record of the previous page (the `nextCursor` it reported)","kind":"value","name":"cursor","possibleValues":[],"repeatable":false,"required":false,"valueName":"CURSOR"},{"aliases":[],"conflictsWith":["--limit"],"default":[],"help":"Return every record from the cursor on, not one page","kind":"flag","name":"all","possibleValues":[],"repeatable":false,"required":false},{"aliases":[],"default":[],"help":"With --json, keep only these top-level record fields (comma-separated); an unknown field is refused","kind":"value","name":"fields","possibleValues":[],"repeatable":false,"required":false,"valueName":"FIELDS"}],"outputs":[{"kind":"report","report":"QueryReport","schemaRef":null,"schemaVersion":null}],"path":["query"],"requiredOneOf":[],"roles":["planner","implementer","reviewer","orchestrator"],"supportsJson":true},"meta":{"command":"schema","schemaVersion":"1.0","canonVersion":"0.27.0","context":{"role":null,"actor":"canon","repo":"."}}}
