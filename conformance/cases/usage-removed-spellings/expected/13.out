{"data":{"about":"Read stored records across every storage tier","aliases":[],"arguments":[],"command":"query","effect":"read","effectNote":"appends one line per run to the read-access audit log .canon/audit/access.jsonl, which `canon init` gitignores and which is never committed; changes nothing else","errorCodes":["CONFIG_MISSING","INVALID_CURSOR","QUERY_FAILED","QUERY_INVALID_ARGUMENT","UNKNOWN_FIELD","UNKNOWN_ROLE","USAGE"],"example":"canon query --kind evidence","exits":[{"code":0,"meaning":"success"},{"code":1,"meaning":"operational failure, or a blocking finding the command reports"},{"code":2,"meaning":"refused: the invocation or its inputs are wrong and fixable; nothing was written"}],"options":[{"aliases":[],"default":[],"help":"Record kind to read (e.g. handoff, strategy_item)","kind":"value","name":"kind","possibleValues":["change","task","scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"],"repeatable":false,"required":true,"valueName":"KIND"},{"aliases":[],"default":[],"help":"Only records with at >= <since> (RFC3339/ISO-8601)","kind":"value","name":"since","possibleValues":[],"repeatable":false,"required":false,"valueName":"SINCE"},{"aliases":[],"default":["nearest ancestor directory with a canon.yaml"],"help":"Repo root (default: nearest ancestor with a canon.yaml)","kind":"value","name":"repo","possibleValues":[],"repeatable":false,"required":false,"valueName":"REPO"},{"aliases":[],"default":[],"help":"Explicit canon.yaml path (overrides --repo resolution)","kind":"value","name":"canon-yaml","possibleValues":[],"repeatable":false,"required":false,"valueName":"CANON_YAML"},{"aliases":[],"default":["false"],"help":"Output JSON instead of the human-readable form","kind":"flag","name":"json","possibleValues":[],"repeatable":false,"required":false,"valueName":null},{"aliases":[],"default":[],"help":"Project a plugin's overlay fields onto each record (fail-soft)","kind":"value","name":"plugin","possibleValues":[],"repeatable":false,"required":false,"valueName":"PLUGIN"},{"aliases":[],"default":["false"],"help":"Every version of the kind, the ledger's and the archive's, oldest first, instead of the current records","kind":"flag","name":"history","possibleValues":[],"repeatable":false,"required":false,"valueName":null},{"aliases":[],"default":[],"help":"Scope --kind change/task to one ChangeId (other kinds exit 2)","kind":"value","name":"change-id","possibleValues":[],"repeatable":false,"required":false,"valueName":"CHANGE_ID"},{"aliases":[],"default":[],"help":"Scope --kind change/task by status field (other kinds exit 2)","kind":"value","name":"status","possibleValues":[],"repeatable":false,"required":false,"valueName":"STATUS"},{"aliases":[],"default":[],"help":"Scope --kind subject by domain (other kinds exit 2)","kind":"value","name":"domain","possibleValues":[],"repeatable":false,"required":false,"valueName":"DOMAIN"},{"aliases":[],"default":["false"],"help":"Permit sensitive query output only when policy explicitly allows it","kind":"flag","name":"include-sensitive","possibleValues":[],"repeatable":false,"required":false,"valueName":null},{"aliases":[],"default":[],"help":"Return at most this many records (default 100)","kind":"value","name":"limit","possibleValues":[],"repeatable":false,"required":false,"valueName":"LIMIT"},{"aliases":[],"default":[],"help":"Resume after the last record of the previous page (the `nextCursor` it reported)","kind":"value","name":"cursor","possibleValues":[],"repeatable":false,"required":false,"valueName":"CURSOR"},{"aliases":[],"default":["false"],"help":"Return every record from the cursor on, not one page","kind":"flag","name":"all","possibleValues":[],"repeatable":false,"required":false,"valueName":null},{"aliases":[],"default":[],"help":"With --json, keep only these top-level record fields (comma-separated); an unknown field is refused","kind":"value","name":"fields","possibleValues":[],"repeatable":true,"required":false,"valueName":"FIELDS"},{"aliases":[],"default":[],"help":"The role you act as: planner, implementer, reviewer or orchestrator. Overrides `CANON_ROLE`. `schema` lists the role's commands, `status` keeps its steps, and `--role` on `evidence add` / `review add` defaults to it","kind":"value","name":"as","possibleValues":["planner","implementer","reviewer","orchestrator"],"repeatable":false,"required":false,"valueName":"ROLE"}],"path":["query"],"roles":["planner","implementer","reviewer","orchestrator"],"supportsJson":true},"meta":{"command":"schema"}}
