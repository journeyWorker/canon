{"ok":true,"data":{"kind":"command","command":"query","path":["query"],"summary":"Read stored records across every storage tier","effect":"read","effectNote":"appends one line to .canon/audit/access.jsonl; a refused run writes none","operands":[],"options":[{"name":"kind","valueName":"KIND","valueType":"enum","possibleValues":["change","task","scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"],"required":true,"repeatable":false,"default":null,"help":"Record kind to read (e.g. handoff, strategy_item)"},{"name":"since","valueName":"TIMESTAMP","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Only records with at >= <since> (RFC3339/ISO-8601)"},{"name":"repo","valueName":"DIR","valueType":"path","required":false,"repeatable":false,"default":null,"defaultNote":"the nearest ancestor directory holding a canon.yaml","flagOnly":true,"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)"},{"name":"json","valueType":"switch","required":false,"repeatable":false,"default":false,"flagOnly":true,"help":"Output JSON instead of the human-readable form"},{"name":"plugin","valueName":"PLUGIN_ID","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Project a plugin's overlay fields onto each record (fail-soft)"},{"name":"history","valueType":"switch","required":false,"repeatable":false,"default":false,"help":"Every version of the kind, the ledger's and the archive's, oldest first, instead of the current records"},{"name":"change","valueName":"CHANGE_ID","valueType":"string","required":false,"repeatable":false,"default":null,"defaultNote":"the repo's only live change","help":"Scope --kind change/task to one ChangeId (other kinds exit 2)"},{"name":"status","valueName":"STATUS","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Scope --kind change/task by status field (other kinds exit 2)"},{"name":"domain","valueName":"NAME","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Scope --kind subject by domain (other kinds exit 2)"},{"name":"include-sensitive","valueType":"switch","required":false,"repeatable":false,"default":false,"help":"Permit sensitive query output only when policy explicitly allows it"},{"name":"limit","valueName":"N","valueType":"integer","required":false,"repeatable":false,"default":100,"help":"Return at most this many records per page"},{"name":"cursor","valueName":"CURSOR","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Resume after the last record of the previous page (the `nextCursor` it reported)"},{"name":"all","valueType":"switch","required":false,"repeatable":false,"default":false,"help":"Return every record from the cursor on, not one page"},{"name":"fields","valueName":"FIELDS","valueType":"string","required":false,"repeatable":false,"default":null,"help":"With --json, keep only these top-level record fields (comma-separated); an unknown field is refused (camelCase and snake_case both match)"},{"name":"as","valueName":"ROLE","valueType":"enum","possibleValues":["planner","implementer","reviewer","orchestrator"],"required":false,"repeatable":false,"default":null,"flagOnly":true,"help":"The role you act as: planner, implementer, reviewer or orchestrator. Overrides `CANON_ROLE`. `schema` and `context` list only the role's commands, `status` keeps its steps, and `--role` on `evidence add` / `evidence audit` / `review scenario` / `review change` is this role unless given"}],"errors":["CONFIG_MISSING","CURSOR_INVALID","INTERNAL","QUERY_FAILED","QUERY_INVALID_ARGUMENT","UNKNOWN_ROLE","USAGE"],"outputs":[{"kind":"report","schemaRef":"#/schemas/QueryReport","schemaVersion":"1.0"}],"examples":["canon query --kind evidence --json"],"schemas":{"DanglingRecord":{"description":"One record's unresolved reference.","properties":{"field":{"type":"string"},"id":{"type":"string"},"record":{"description":"The record's id, as the query's ID column shows it.","type":"string"},"target":{"description":"The kind of thing the field names: `change`, `review`, `task` or `scenario`.","type":"string"}},"required":["record","field","target","id"],"type":"object"},"LedgerRecord":{"description":"A ledger record, verbatim: it keeps its own schema (`crates/canon-model/schemas/<kind>.schema.json`), minus anything redacted or left out by `--fields`","type":"object"},"QueryDangling":{"description":"The unresolved references of a query (0.30 `record-links`): the count and the count per kind of reference\ncover every record the query found, `references` the records of this page.","properties":{"byReference":{"additionalProperties":{"format":"uint","minimum":0,"type":"integer"},"description":"`<record kind>.<field>` to its count.","type":"object"},"count":{"format":"uint","minimum":0,"type":"integer"},"references":{"items":{"$ref":"#/schemas/DanglingRecord"},"type":"array"},"unchecked":{"description":"Why nothing was checked, when the sources could not be read.","type":["string","null"]}},"required":["count","byReference","references"],"type":"object"},"QueryReport":{"description":"`canon query --json`'s report (`QueryReport`): the page state travels in\n`meta` ([`QueryOutcome::page`]), not here.","properties":{"count":{"format":"uint","minimum":0,"type":"integer"},"dangling":{"anyOf":[{"$ref":"#/schemas/QueryDangling"},{"type":"null"}],"description":"`--kind finding|evidence|subject` (0.30): the references to a source nothing committed holds."},"kind":{"type":"string"},"overlays":{"description":"The overlay identities actually projected.","items":{"type":"string"},"type":["array","null"]},"plugin":{"description":"The resolved plugin id (`--plugin`) when its overlays were projected.","type":["string","null"]},"records":{"items":{"$ref":"#/schemas/LedgerRecord"},"type":"array"},"rollup":{"anyOf":[{"$ref":"#/schemas/QueryRollup"},{"type":"null"}],"description":"`--kind task`: tasks done of tasks listed."},"since":{"type":["string","null"]},"violations":{"description":"Records the tiers reported as violations and the query left out.","format":"uint","minimum":0,"type":"integer"}},"required":["kind","since","count","violations","records"],"title":"QueryReport","type":"object"},"QueryRollup":{"properties":{"done":{"format":"uint","minimum":0,"type":"integer"},"total":{"format":"uint","minimum":0,"type":"integer"}},"required":["done","total"],"type":"object"}},"x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},"meta":{"command":"schema","schemaVersion":"1.1","tool":"canon","toolVersion":"0.33.0","contract":"atip/1","contractVersion":"1.1"}}
