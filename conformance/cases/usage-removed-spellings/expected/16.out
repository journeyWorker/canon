{"ok":true,"data":{"kind":"command","command":"query","summary":"Read stored records across every storage tier","effect":"read","effectNote":"appends one line to .canon/audit/access.jsonl; a refused run writes none","options":[{"name":"kind","valueType":"enum","possibleValues":["change","task","scenario","run","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"],"required":true,"help":"Record kind to read (e.g. handoff, strategy_item)"},{"name":"since","valueName":"TIMESTAMP","domain":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[-+][0-9]{2}:[0-9]{2}))?$"},"help":"Only records with at >= <since>: an RFC 3339 date (`2030-01-01`, UTC midnight) or date-time (`<ts>`)"},"repo",{"name":"plugin","valueName":"PLUGIN_ID","help":"Project a plugin's overlay fields onto each record (fail-soft)"},{"name":"history","valueType":"switch","help":"Every version of the kind, the ledger's and the archive's, oldest first, instead of the current records"},{"name":"change","valueName":"CHANGE_ID","defaultNote":"the repo's only live change","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"Scope --kind change/task to one ChangeId (other kinds exit 2)"},{"name":"status","help":"Scope --kind change/task by status field (other kinds exit 2)"},{"name":"domain","valueName":"NAME","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"Scope --kind subject by domain (other kinds exit 2)"},{"name":"include-sensitive","valueType":"switch","help":"Permit sensitive query output only when policy explicitly allows it"},"limit","cursor","all","as"],"constraints":[{"rule":"atMostOne","names":["plugin","history"]},{"rule":"atMostOne","names":["limit","all"]},{"rule":"forbids","if":{"name":"kind","in":["scenario","run","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"]},"then":["change"],"code":"QUERY_ARGUMENT_INVALID","help":"`--change` applies only to `--kind change` and `--kind task`."},{"rule":"forbids","if":{"name":"kind","in":["scenario","run","handoff","review","divergence","trajectory","strategy_item","evidence","finding"]},"then":["status"],"code":"QUERY_ARGUMENT_INVALID","help":"`--status` applies only to `--kind change`, `--kind task` and `--kind subject`."},{"rule":"forbids","if":{"name":"kind","in":["change","task","scenario","run","handoff","review","divergence","trajectory","strategy_item","evidence","finding"]},"then":["domain"],"code":"QUERY_ARGUMENT_INVALID","help":"`--domain` applies only to `--kind subject`."}],"validators":[{"arguments":["kind","status"],"code":"QUERY_ARGUMENT_INVALID","description":"`--status` is one of the statuses of the queried kind: `open`, `done` for `task`; `proposed`, `in_progress`, `completed`, `archived` for `change`; `proposed`, `specced`, `building`, `verifying`, `shipped`, `retired` for `subject`."},{"arguments":["since"],"code":"USAGE","description":"Reads the value as RFC 3339: a date (`2030-01-01`, UTC midnight) or a date-time (`<ts>`); the date must exist on the calendar: `2026-02-30` is refused."}],"errors":["CONFIG_INVALID","CONFIG_REQUIRED","QUERY_FAILED","REPO_DENIED","REPO_INVALID","REPO_UNAVAILABLE","ROLE_INVALID"],"outputs":[{"schemaRef":"#/schemas/QueryReport","fields":{"records":"/records","paths":["abandoned_at","actor","approval","artifacts","at","attachments","audit","body","brief_override","case","chain_id","change_id","change_ids","ci","claimed_at","claimed_by","code_tree","completed_at","content","depends_on","description","detail","disposition","domain","ended_at","evidence_note","evidence_sha","file_ref","flagged","from_role","id","injected_guidance","introduced_by","introduced_unknown","kind","lane","lifecycle","lineage","openspec_change_slug","outcome","overlay","owner_role","parent_handoff_id","parent_run_id","pin","pins","pr","project_id","provenance_ref","reason","regime_key","removed","reopen","research_vendor_slug","resolution_code_tree","resolution_sha","resolution_worktree_dirty","review_id","reviewed_sha","reviewer","reviewer_harness","reviewer_model","reviewer_provider","reward","role","round","run_id","run_seq","scenario_digest","scenario_id","scenario_ids","scenario_refs","schema","seq","session_id","severity","sha","source_digest","source_task_id","started_at","state","status","status_override","status_reason","steps","subject_id","subject_ids","summary","surface_ref","tags","task_id","title","to_role","verdict","worktree_dirty"]}}],"examples":["canon query --kind evidence --json"],"x-canon":{"roles":"all"}},"meta":{"command":"schema","schemaVersion":"1.6","tool":"canon","toolVersion":"0.41.0","contract":"atip/1","contractVersion":"1.6"}}
