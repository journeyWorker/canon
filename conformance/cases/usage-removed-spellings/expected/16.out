{"ok":true,"data":{"kind":"command","command":"query","path":["query"],"summary":"Read stored records across every storage tier","effect":"read","effectNote":"appends one line to .canon/audit/access.jsonl; a refused run writes none","operands":[],"options":[{"name":"kind","valueName":"KIND","valueType":"enum","possibleValues":["change","task","scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"],"required":true,"repeatable":false,"default":null,"help":"Record kind to read (e.g. handoff, strategy_item)"},{"name":"since","valueName":"TIMESTAMP","valueType":"string","required":false,"repeatable":false,"default":null,"domain":{"pattern":"^([ \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　]*[-+]?[0-9]+-[ \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　]*[0-9]{1,2}-[ \\t\\n\u000b\f\\r   - \\p{Zl}\\p{Zp}  　]*[0-9]{1,2}|[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[-+−][0-9]{2}:[0-9]{2}))$"},"help":"Only records with at >= <since> (RFC3339/ISO-8601)"},{"name":"repo","valueName":"DIR","valueType":"path","required":false,"repeatable":false,"default":null,"defaultNote":"the nearest ancestor directory holding a canon.yaml","flagOnly":true,"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)"},{"name":"json","valueType":"switch","required":false,"repeatable":false,"default":false,"flagOnly":true,"help":"Output JSON instead of the human-readable form"},{"name":"plugin","valueName":"PLUGIN_ID","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Project a plugin's overlay fields onto each record (fail-soft)"},{"name":"history","valueType":"switch","required":false,"repeatable":false,"default":false,"help":"Every version of the kind, the ledger's and the archive's, oldest first, instead of the current records"},{"name":"change","valueName":"CHANGE_ID","valueType":"string","required":false,"repeatable":false,"default":null,"defaultNote":"the repo's only live change","domain":{"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"},"help":"Scope --kind change/task to one ChangeId (other kinds exit 2)"},{"name":"status","valueName":"STATUS","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Scope --kind change/task by status field (other kinds exit 2)"},{"name":"domain","valueName":"NAME","valueType":"string","required":false,"repeatable":false,"default":null,"help":"Scope --kind subject by domain (other kinds exit 2)"},{"name":"include-sensitive","valueType":"switch","required":false,"repeatable":false,"default":false,"help":"Permit sensitive query output only when policy explicitly allows it"},{"name":"limit","valueName":"N","valueType":"integer","required":false,"repeatable":false,"default":100,"flagOnly":true,"domain":{"minimum":1},"help":"Return at most this many records per page"},{"name":"cursor","valueName":"CURSOR","valueType":"string","required":false,"repeatable":false,"default":null,"flagOnly":true,"help":"Resume after the last record of the previous page (the `nextCursor` it reported)"},{"name":"all","valueType":"switch","required":false,"repeatable":false,"default":false,"flagOnly":true,"help":"Return every record from the cursor on, not one page"},{"name":"fields","valueName":"FIELDS","valueType":"string","required":false,"repeatable":false,"default":null,"flagOnly":true,"help":"With --json, keep only these members of each record (comma-separated field paths; `canon schema query --json` lists them under outputs[].fields.paths)"},{"name":"as","valueName":"ROLE","valueType":"enum","possibleValues":["planner","implementer","reviewer","orchestrator"],"required":false,"repeatable":false,"default":null,"env":"CANON_ROLE","flagOnly":true,"help":"The role you act as: planner, implementer, reviewer or orchestrator. Overrides `CANON_ROLE`. `schema` and `context` list only the role's commands, `status` keeps its steps, and `--role` on `evidence add` / `evidence audit` / `review scenario` / `review change` is this role unless given"}],"constraints":[{"rule":"atMostOne","names":["plugin","history"]},{"rule":"atMostOne","names":["limit","all"]},{"rule":"forbids","if":{"name":"kind","in":["scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"]},"then":["change"],"code":"QUERY_ARGUMENT_INVALID","help":"`--change` applies only to `--kind change` and `--kind task`."},{"rule":"forbids","if":{"name":"kind","in":["scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","finding"]},"then":["status"],"code":"QUERY_ARGUMENT_INVALID","help":"`--status` applies only to `--kind change`, `--kind task` and `--kind subject`."},{"rule":"forbids","if":{"name":"kind","in":["change","task","scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","finding"]},"then":["domain"],"code":"QUERY_ARGUMENT_INVALID","help":"`--domain` applies only to `--kind subject`."}],"validators":[{"arguments":["kind","status"],"code":"QUERY_ARGUMENT_INVALID","description":"`--status` is one of the statuses of the queried kind: `open`, `done` for `task`; `proposed`, `in_progress`, `completed`, `archived` for `change`; `proposed`, `specced`, `building`, `verifying`, `shipped`, `retired` for `subject`.","rejects":["canon query --kind task --status proposed --json"]},{"arguments":["since"],"code":"USAGE","description":"Reads the value as RFC 3339 (`<ts>`) or a date (`2030-01-01`, UTC midnight); the date must exist on the calendar: `2026-02-30` is refused.","rejects":["canon query --kind evidence --since 2026-02-30 --json"]}],"errors":["CONFIG_REQUIRED","CURSOR_INVALID","INTERNAL","QUERY_ARGUMENT_INVALID","QUERY_FAILED","ROLE_INVALID","USAGE"],"outputs":[{"kind":"report","schemaRef":"#/schemas/QueryReport","schemaVersion":"1.0","fields":{"records":"/records","paths":["abandoned_at","actor","approval","artifacts","at","attachments","audit","body","brief_override","case","chain_id","change_id","change_ids","claimed_at","claimed_by","client","code_tree","completed_at","content","depends_on","description","detail","disposition","domain","ended_at","evidence_note","evidence_sha","file_ref","flagged","from_role","id","injected_guidance","introduced_by","introduced_unknown","kind","label","lane","lifecycle","lineage","openspec_change_slug","outcome","overlay","owner_role","parent_handoff_id","parent_run_id","pin","pins","pr","project_id","project_key","provenance_ref","reason","regime_key","removed","reopen","research_vendor_slug","resolution_code_tree","resolution_sha","resolution_worktree_dirty","review_id","reviewed_sha","reviewer","reviewer_harness","reviewer_model","reviewer_provider","reward","role","round","run_id","run_seq","scenario_digest","scenario_id","scenario_ids","scenario_refs","schema","seq","session_id","severity","sha","source_digest","source_task_id","started_at","state","status","status_override","status_reason","steps","subject_id","subject_ids","summary","surface_ref","tags","task_id","title","to_role","verdict","workspace_key","workspace_label","worktree_dirty"]}}],"examples":["canon query --kind evidence --json"],"schemas":{"DanglingRecord":{"description":"One record's unresolved reference.","properties":{"field":{"type":"string"},"id":{"type":"string"},"record":{"description":"The record's id, as the query's ID column shows it.","type":"string"},"target":{"description":"The kind of thing the field names: `change`, `review`, `task` or `scenario`.","type":"string"}},"required":["record","field","target","id"],"type":"object"},"QueryDangling":{"description":"The unresolved references of a query (0.30 `record-links`): the count and the count per kind of reference\ncover every record the query found, `references` the records of this page.","properties":{"byReference":{"additionalProperties":{"format":"uint","minimum":0,"type":"integer"},"description":"`<record kind>.<field>` to its count.","type":"object"},"count":{"format":"uint","minimum":0,"type":"integer"},"references":{"items":{"$ref":"#/schemas/DanglingRecord"},"type":"array"},"unchecked":{"description":"Why nothing was checked, when the sources could not be read.","type":["string","null"]}},"required":["count","byReference","references"],"type":"object"},"QueryRecord":{"description":"A ledger record of the kind `--kind` names, verbatim: it keeps its own snake_case members (`crates/canon-model/schemas/<kind>.schema.json`), minus anything redacted. `properties` lists the members of every kind; a record has the ones its kind declares","properties":{"abandoned_at":{"description":"a member of the records of: handoff"},"actor":{"description":"a member of the records of: change, task, scenario, session, run, event, handoff, review, divergence, trajectory, strategy_item, evidence, subject, finding"},"approval":{"description":"a member of the records of: evidence"},"artifacts":{"description":"a member of the records of: review"},"at":{"description":"a member of the records of: change, task, scenario, session, run, event, handoff, review, divergence, trajectory, strategy_item, evidence, subject, finding"},"attachments":{"description":"a member of the records of: evidence"},"audit":{"description":"a member of the records of: evidence"},"body":{"description":"a member of the records of: handoff"},"brief_override":{"description":"a member of the records of: evidence"},"case":{"description":"a member of the records of: scenario"},"chain_id":{"description":"a member of the records of: handoff"},"change_id":{"description":"a member of the records of: change, review, finding"},"change_ids":{"description":"a member of the records of: subject"},"claimed_at":{"description":"a member of the records of: handoff"},"claimed_by":{"description":"a member of the records of: handoff"},"client":{"description":"a member of the records of: session"},"code_tree":{"description":"a member of the records of: review, divergence, evidence, finding"},"completed_at":{"description":"a member of the records of: handoff"},"content":{"description":"a member of the records of: strategy_item"},"depends_on":{"description":"a member of the records of: task"},"description":{"description":"a member of the records of: scenario"},"detail":{"description":"a member of the records of: event, divergence"},"disposition":{"description":"a member of the records of: finding"},"domain":{"description":"a member of the records of: subject"},"ended_at":{"description":"a member of the records of: session, run"},"evidence_note":{"description":"a member of the records of: task"},"evidence_sha":{"description":"a member of the records of: evidence"},"file_ref":{"description":"a member of the records of: finding"},"flagged":{"description":"a member of the records of: evidence"},"from_role":{"description":"a member of the records of: handoff"},"id":{"description":"a member of the records of: handoff"},"injected_guidance":{"description":"a member of the records of: run"},"introduced_by":{"description":"a member of the records of: finding"},"introduced_unknown":{"description":"a member of the records of: finding"},"kind":{"description":"a member of the records of: change, task, scenario, session, run, event, handoff, review, divergence, trajectory, strategy_item, evidence, subject, finding"},"label":{"description":"a member of the records of: event"},"lane":{"description":"a member of the records of: scenario"},"lifecycle":{"description":"a member of the records of: evidence"},"lineage":{"description":"a member of the records of: run"},"openspec_change_slug":{"description":"a member of the records of: handoff"},"outcome":{"description":"a member of the records of: review"},"overlay":{"description":"with --plugin, the plugin's projected members of the record"},"owner_role":{"description":"a member of the records of: subject"},"parent_handoff_id":{"description":"a member of the records of: handoff"},"parent_run_id":{"description":"a member of the records of: run"},"pin":{"description":"a member of the records of: review"},"pins":{"description":"a member of the records of: review"},"pr":{"description":"a member of the records of: trajectory"},"project_id":{"description":"a member of the records of: scenario, review, divergence, evidence"},"project_key":{"description":"a member of the records of: session"},"provenance_ref":{"description":"a member of the records of: review"},"reason":{"description":"a member of the records of: finding"},"regime_key":{"description":"a member of the records of: strategy_item"},"removed":{"description":"a member of the records of: scenario"},"reopen":{"description":"a member of the records of: subject"},"research_vendor_slug":{"description":"a member of the records of: handoff"},"resolution_code_tree":{"description":"a member of the records of: finding"},"resolution_sha":{"description":"a member of the records of: finding"},"resolution_worktree_dirty":{"description":"a member of the records of: finding"},"review_id":{"description":"a member of the records of: review, finding"},"reviewed_sha":{"description":"a member of the records of: finding"},"reviewer":{"description":"a member of the records of: review, divergence, finding"},"reviewer_harness":{"description":"a member of the records of: review"},"reviewer_model":{"description":"a member of the records of: review"},"reviewer_provider":{"description":"a member of the records of: review"},"reward":{"description":"a member of the records of: trajectory"},"role":{"description":"a member of the records of: strategy_item"},"round":{"description":"a member of the records of: divergence, finding"},"run_id":{"description":"a member of the records of: run, event, trajectory, evidence"},"run_seq":{"description":"a member of the records of: divergence, evidence"},"scenario_digest":{"description":"a member of the records of: scenario"},"scenario_id":{"description":"a member of the records of: scenario, review, divergence, evidence"},"scenario_ids":{"description":"a member of the records of: finding"},"scenario_refs":{"description":"a member of the records of: task"},"schema":{"description":"a member of the records of: change, task, scenario, session, run, event, handoff, review, divergence, trajectory, strategy_item, evidence, subject, finding"},"seq":{"description":"a member of the records of: event, handoff, finding"},"session_id":{"description":"a member of the records of: session, run, trajectory"},"severity":{"description":"a member of the records of: finding"},"sha":{"description":"a member of the records of: divergence, trajectory"},"source_digest":{"description":"a member of the records of: scenario"},"source_task_id":{"description":"a member of the records of: strategy_item"},"started_at":{"description":"a member of the records of: session, run"},"state":{"description":"a member of the records of: handoff"},"status":{"description":"a member of the records of: change, task, run, divergence, subject"},"status_override":{"description":"a member of the records of: subject"},"status_reason":{"description":"a member of the records of: subject"},"steps":{"description":"a member of the records of: scenario"},"subject_id":{"description":"a member of the records of: scenario, subject"},"subject_ids":{"description":"a member of the records of: change"},"summary":{"description":"a member of the records of: change, subject, finding"},"surface_ref":{"description":"a member of the records of: evidence"},"tags":{"description":"a member of the records of: handoff"},"task_id":{"description":"a member of the records of: task, run, trajectory, evidence"},"title":{"description":"a member of the records of: change, task, scenario, handoff, subject"},"to_role":{"description":"a member of the records of: handoff"},"verdict":{"description":"a member of the records of: evidence"},"workspace_key":{"description":"a member of the records of: session"},"workspace_label":{"description":"a member of the records of: session"},"worktree_dirty":{"description":"a member of the records of: review, divergence, evidence, finding"}},"type":"object"},"QueryReport":{"description":"`canon query --json`'s report (`QueryReport`): the page state travels in\n`meta` ([`QueryOutcome::page`]), not here.","properties":{"count":{"description":"The records in this answer: report content, not paging state (`meta.page` is the paging).","format":"uint","minimum":0,"type":"integer"},"dangling":{"anyOf":[{"$ref":"#/schemas/QueryDangling"},{"type":"null"}],"description":"`--kind finding|evidence|subject` (0.30): the references to a source nothing committed holds."},"kind":{"type":"string"},"overlays":{"description":"The overlay identities actually projected.","items":{"type":"string"},"type":["array","null"]},"plugin":{"description":"The resolved plugin id (`--plugin`) when its overlays were projected.","type":["string","null"]},"records":{"items":{"$ref":"#/schemas/QueryRecord"},"type":"array"},"rollup":{"anyOf":[{"$ref":"#/schemas/QueryRollup"},{"type":"null"}],"description":"`--kind task`: tasks done of tasks listed."},"since":{"type":["string","null"]},"violations":{"description":"Records the tiers reported as violations and the query left out.","format":"uint","minimum":0,"type":"integer"}},"required":["kind","since","count","violations","records"],"title":"QueryReport","type":"object"},"QueryRollup":{"properties":{"done":{"format":"uint","minimum":0,"type":"integer"},"total":{"format":"uint","minimum":0,"type":"integer"}},"required":["done","total"],"type":"object"}},"x-canon":{"roles":["planner","implementer","reviewer","orchestrator"]}},"meta":{"command":"schema","schemaVersion":"1.2","tool":"canon","toolVersion":"0.35.0","contract":"atip/1","contractVersion":"1.2"}}
