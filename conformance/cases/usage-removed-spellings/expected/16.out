{"ok":true,"data":{"command":"query","path":["query"],"name":"query","nodeKind":"leaf","aliases":[],"about":"Read stored records across every storage tier","effect":"read","effectNote":"appends one line to .canon/audit/access.jsonl; a refused run writes none","roles":["planner","implementer","reviewer","orchestrator"],"supportsJson":true,"operands":[],"options":[{"name":"kind","kind":"value","aliases":[],"valueName":"KIND","required":true,"repeatable":false,"possibleValues":["change","task","scenario","session","run","event","handoff","review","divergence","trajectory","strategy_item","evidence","subject","finding"],"default":[],"help":"Record kind to read (e.g. handoff, strategy_item)"},{"name":"since","kind":"value","aliases":[],"valueName":"TIMESTAMP","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Only records with at >= <since> (RFC3339/ISO-8601)"},{"name":"repo","kind":"value","aliases":[],"valueName":"DIR","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)"},{"name":"json","kind":"flag","aliases":[],"required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Output JSON instead of the human-readable form"},{"name":"plugin","kind":"value","aliases":[],"valueName":"PLUGIN_ID","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Project a plugin's overlay fields onto each record (fail-soft)","conflictsWith":["--history"]},{"name":"history","kind":"flag","aliases":[],"required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Every version of the kind, the ledger's and the archive's, oldest first, instead of the current records","conflictsWith":["--plugin"]},{"name":"change","kind":"value","aliases":[],"valueName":"CHANGE_ID","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Scope --kind change/task to one ChangeId (other kinds exit 2)"},{"name":"status","kind":"value","aliases":[],"valueName":"STATUS","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Scope --kind change/task by status field (other kinds exit 2)"},{"name":"domain","kind":"value","aliases":[],"valueName":"NAME","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Scope --kind subject by domain (other kinds exit 2)"},{"name":"include-sensitive","kind":"flag","aliases":[],"required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Permit sensitive query output only when policy explicitly allows it"},{"name":"limit","kind":"value","aliases":[],"valueName":"N","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Return at most this many records (default 100)","conflictsWith":["--all"]},{"name":"cursor","kind":"value","aliases":[],"valueName":"CURSOR","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Resume after the last record of the previous page (the `nextCursor` it reported)"},{"name":"all","kind":"flag","aliases":[],"required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Return every record from the cursor on, not one page","conflictsWith":["--limit"]},{"name":"fields","kind":"value","aliases":[],"valueName":"FIELDS","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"With --json, keep only these top-level record fields (comma-separated); an unknown field is refused (camelCase and snake_case both match)"}],"requiredOneOf":[],"exits":[{"code":0,"meaning":"success"},{"code":1,"meaning":"failed: INTERNAL, QUERY_FAILED"},{"code":2,"meaning":"refused: CONFIG_MISSING, or an input that is missing, unreadable or invalid; nothing is written"}],"errorCodes":["CONFIG_MISSING","CURSOR_INVALID","INTERNAL","QUERY_FAILED","QUERY_INVALID_ARGUMENT","UNKNOWN_ROLE","USAGE"],"outputs":[{"kind":"report","report":"QueryReport","schemaRef":"#/schemas/QueryReport","schemaVersion":"1.0"}],"inputs":[],"examples":["canon query --kind evidence"]},"meta":{"command":"schema","schemaVersion":"1.0","tool":"canon","toolVersion":"0.33.0","contract":"atip/1"}}
