{"ok":true,"data":{"command":"brief approve","path":["brief","approve"],"name":"approve","nodeKind":"leaf","aliases":[],"about":"Record the human's approval of the brief, bound to its text; refused while `brief check` has blockers","effect":"write","idempotency":"replay-safe","roles":[],"supportsJson":true,"operands":[{"name":"change_ids","kind":"CHANGE_ID","arity":{"min":0},"required":false,"repeatable":true,"possibleValues":[],"description":"The changes to approve, one answer for all, none written unless every one is approvable (default: the repo's only live change)"}],"options":[{"name":"approver","kind":"value","aliases":[],"valueName":"NAME","required":true,"repeatable":false,"possibleValues":[],"default":[],"help":"Who approved (the human, not the agent)"},{"name":"note","kind":"value","aliases":[],"valueName":"TEXT","required":true,"repeatable":false,"possibleValues":[],"default":[],"help":"The human's own words"},{"name":"repo","kind":"value","aliases":[],"valueName":"DIR","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)"},{"name":"json","kind":"flag","aliases":[],"required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"Output JSON instead of the human-readable form"},{"name":"input","kind":"value","aliases":[],"valueName":"JSON|FILE|-","required":false,"repeatable":false,"possibleValues":[],"default":[],"help":"The arguments as JSON: an object (one run) or an array / NDJSON file or `-` (a batch); keys are the option names in camelCase, `operands` an array"}],"requiredOneOf":[],"exits":[{"code":0,"meaning":"success"},{"code":1,"meaning":"failed: BRIEF_WRITE_FAILED, INPUT_ELEMENT_FAILED"},{"code":2,"meaning":"refused: CONFIG_MISSING, or an input that is missing, unreadable or invalid; nothing is written"}],"errorCodes":["APPROVAL_INCOMPLETE","BRIEF_APPROVE_REFUSED","BRIEF_NOT_FOUND","BRIEF_UNAPPROVABLE","BRIEF_UNREADABLE","BRIEF_WRITE_FAILED","CHANGE_AMBIGUOUS","CONFIG_MISSING","CONFIG_UNREADABLE","HUMAN_ONLY","INPUT_CONFLICT","INPUT_ELEMENT_FAILED","INPUT_INVALID","INPUT_INVALID_TYPE","INPUT_STDIN_CONFLICT","INPUT_STDIN_TTY","INPUT_TOO_LARGE","INPUT_UNKNOWN_FIELD","INPUT_UNREADABLE","NO_BRIEF","POLICY_APPROVAL_FAILED","SPEC_ROOTS_UNREADABLE","UNKNOWN_ROLE","USAGE"],"outputs":[{"kind":"report","report":"BriefApproveReport","schemaRef":"#/schemas/BriefApproveReport","schemaVersion":"1.0"},{"kind":"report","report":"BriefApproveManyReport","schemaRef":"#/schemas/BriefApproveManyReport","schemaVersion":"1.0"},{"kind":"report","report":"BatchBriefApproveReport","schemaRef":"#/schemas/BatchBriefApproveReport","schemaVersion":"1.0","batch":true}],"inputs":[{"option":"--input","schemaRef":"#/schemas/BriefApproveInput","maxBytes":8388608,"maxElements":10000,"batch":true,"example":{"approver":"alice","note":"approved as written","operands":["add-search"]}}],"examples":["canon brief approve add-search --approver alice --note \"approved as written\""]},"meta":{"command":"schema","schemaVersion":"1.0","canonVersion":"0.30.0","context":{"role":null,"actor":"canon","repo":"."}}}
