{"ok":true,"data":{"about":"Record the human's approval of the brief, bound to its text; refused while `brief check` has blockers","aliases":[],"command":"brief approve","effect":"write","errorCodes":["APPROVAL_INCOMPLETE","BRIEF_HAS_BLOCKERS","BRIEF_NOT_FOUND","BRIEF_UNAPPROVABLE","BRIEF_UNREADABLE","BRIEF_WRITE_FAILED","CHANGE_AMBIGUOUS","CONFIG_MISSING","CONFIG_UNREADABLE","HUMAN_ONLY","NO_BRIEF","POLICY_APPROVAL_FAILED","SPEC_ROOTS_UNREADABLE","UNKNOWN_ROLE","USAGE"],"examples":["canon brief approve add-search --approver alice --note \"approved as written\""],"exits":[{"code":0,"meaning":"success"},{"code":2,"meaning":"refused: CONFIG_MISSING, or an input that is missing, unreadable or invalid; nothing is written"}],"idempotency":"replay-safe","inputs":[],"name":"approve","nodeKind":"leaf","operands":[{"arity":{"max":1,"min":0},"description":"The change to read (default: the repo's only live change)","kind":"CHANGE_ID","name":"change_id","possibleValues":[],"repeatable":false,"required":false}],"options":[{"aliases":[],"default":[],"help":"Who approved (the human, not the agent)","kind":"value","name":"approver","possibleValues":[],"repeatable":false,"required":true,"valueName":"APPROVER"},{"aliases":[],"default":[],"help":"The human's own words","kind":"value","name":"note","possibleValues":[],"repeatable":false,"required":true,"valueName":"NOTE"},{"aliases":[],"default":[],"help":"The repo to act on (default: the nearest ancestor directory holding a canon.yaml)","kind":"value","name":"repo","possibleValues":[],"repeatable":false,"required":false,"valueName":"DIR"},{"aliases":[],"default":[],"help":"Output JSON instead of the human-readable form","kind":"flag","name":"json","possibleValues":[],"repeatable":false,"required":false}],"outputs":[{"kind":"report","report":"BriefApproveReport","schemaRef":"#/schemas/BriefApproveReport","schemaVersion":"1.0"}],"path":["brief","approve"],"requiredOneOf":[],"roles":[],"supportsJson":true},"meta":{"command":"schema","sch