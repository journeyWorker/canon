{"data":{"about":"Record the human's approval of the brief, bound to its text; refused while `brief check` has blockers","aliases":[],"arguments":[{"aliases":[],"default":[],"help":"The change to read (default: the repo's only live change)","kind":"positional","name":"change_id","possibleValues":[],"repeatable":false,"required":false,"valueName":"CHANGE_ID"}],"command":"brief approve","effect":"write","errorCodes":["APPROVAL_INCOMPLETE","BRIEF_HAS_BLOCKERS","BRIEF_NOT_FOUND","BRIEF_UNAPPROVABLE","BRIEF_UNREADABLE","BRIEF_WRITE_FAILED","CHANGE_AMBIGUOUS","CONFIG_MISSING","CONFIG_UNREADABLE","NO_BRIEF","POLICY_APPROVAL_FAILED","SPEC_ROOTS_UNREADABLE","UNKNOWN_ROLE","USAGE"],"example":"canon brief approve --by alice --note \"approved as written\"","exits":[{"code":0,"meaning":"success"},{"code":1,"meaning":"operational failure, or a blocking finding the command reports"},{"code":2,"meaning":"refused: the invocation or its inputs are wrong and fixable; nothing was written"}],"options":[{"aliases":[],"default":[],"help":"Who approved (the human, not the agent)","kind":"value","name":"by","possibleValues":[],"repeatable":false,"required":true,"valueName":"BY"},{"aliases":[],"default":[],"help":"The human's own words","kind":"value","name":"note","possibleValues":[],"repeatable":false,"required":true,"valueName":"NOTE"},{"aliases":[],"default":["nearest ancestor directory with a canon.yaml"],"help":"Repo root (default: nearest ancestor with a canon.yaml)","kind":"value","name":"repo","possibleValues":[],"repeatable":false,"required":false,"valueName":"REPO"},{"aliases":[],"default":["false"],"help":"Output JSON instead of the human-readable form","kind":"flag","name":"json","possibleValues":[],"repeatable":false,"required":false,"valueName":null},{"aliases":[],"default":[],"help":"The role you act as: planner, implementer, reviewer or orchestrator. Overrides `CANON_ROLE`. `schema` lists the role's commands, `status` keeps its steps, and `--role` on `evidence add` / `evidence audit` / `review scenario` / `review change` defaults to it","kind":"value","name":"as","possibleValues":["planner","implementer","reviewer","orchestrator"],"repeatable":false,"required":false,"valueName":"ROLE"}],"path":["brief","approve"],"roles":[],"supportsJson":true},"meta":{"command":"schema"}}
