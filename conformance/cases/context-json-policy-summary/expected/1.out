  "joinKeys": {
    "change_id": "openspec change slug: kebab-case (`[a-z0-9]+(-[a-z0-9]+)*`), the directory name under `openspec/changes/`",
    "handoff_id": "the donor CLI's handoff-id grammar: `YYYYMMDD-HHmm-<topic-slug>-<nonce>`",
    "regime_key": "`<role>/<repo>/<area>/<hash>`, four `/`-separated segments, the last a lowercase-hex digest",
    "run_id": "ULID (Crockford base32, 26 chars) — `ulid::Ulid`",
    "scenario_id": "`<area>.<surface>.<nn>` — `[a-z0-9-]+\\.[a-z0-9-]+\\.\\d{2,}`; never renumbered once assigned",
    "session_id": "opaque, non-empty agent-CLI session token; derivation source varies by adapter (Claude Code/Codex: transcript filename stem; omp/pi: in-file header `id` field) — this type validates shape only, never a single fixed format",
    "sha / pr": "git commit SHA-1: exactly 40 lowercase hex characters",
    "subject_id": "subject slug: kebab-case (`[a-z0-9]+(-[a-z0-9]+)*`), the durable product-unit identifier",
    "task_id": "`<change_id>#<n>`, where `<n>` is one or more dot-separated integers (`1`, `1.1`, `6.2`) matching `tasks.md`'s own numbering"
  },
  "policy": {
    "trust_required": {},
    "trust_sample": {},
    "staleness": {
      "max_commits_behind": {
        "kind": "flat",
        "value": 50
      },
      "surface_scoped": {
        "kind": "flat",
        "value": true
      }
    },
    "risk_routing": {
      "reviewer": {
        "kind": "flat",
        "value": true
      }
    },
    "risk_tiers": {},
    "spec_coverage": "require_evidence=true scope=verifying, shipped require_cases=failure",
    "evidence_binding": "INVALID — `strict` is not a valid value for `mode` (expected one of: off, warn, require)",
    "clean": false,
    "diagnostics": [
      "experimental.evidence_binding: section is present but unusable (`strict` is not a valid value for `mode` (expected one of: off, warn, require)) — the owning check refuses rather than treating it as absent"
    ]
  },
