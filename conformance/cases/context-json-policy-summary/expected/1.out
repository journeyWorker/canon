    "ChangeStatus": [
      "archived",
      "completed",
      "in_progress",
      "proposed"
    ],
    "EvidenceVerdict": [
      "divergent",
      "faithful",
      "not_applicable"
    ],
    "FindingDisposition": [
      "deferred",
      "fixed",
      "open",
      "rejected"
    ],
    "FindingSeverity": [
      "blocker",
      "note",
      "should_fix"
    ],
    "HandoffState": [
      "abandoned",
      "done",
      "in-progress",
      "pending"
    ],
    "ReportOutcome": [
      "failed",
      "passed",
      "skipped"
    ],
    "RunStatus": [
      "aborted",
      "failed",
      "pending",
      "running",
      "succeeded"
    ],
    "SubjectStatus": [
      "building",
      "proposed",
      "retired",
      "shipped",
      "specced",
      "verifying"
    ],
    "TaskStatus": [
      "done",
      "open"
    ],
