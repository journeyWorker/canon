target/
node_modules/
dist/
# Prebuilt native binaries staged into platform packages at publish time
# (populated by .github/workflows/build-native.yml / publish.yml, never
# committed).
packages/core-*/bin/*
!packages/core-*/bin/.gitkeep
.superpowers/
*.duckdb
# Local runtime store roots (git/hot/cold-tier ledger + cursors + trajectory,
# written by `canon ingest`/`sync` and tests; derived from committed
# openspec/ + specs/ sources, regenerable, never committed).
#
# ONE exception, carved out by s42 (`close-the-open-loops`): an
# `EvidenceRecord` is not regenerable from any committed source — it is
# an authored attestation, and `canon-report`'s digest module treats the
# evidence ledger as "the git-tracked, PR-reviewed tier". The single
# pre-s42 record under `kind=evidence_record/` had to be `git add -f`'d
# for exactly that reason; now that `canon evidence add` exists, every
# record it authors and `canon gate promote` commits belongs in git
# without a force-add. Written as `ledger/*` + a re-include because a
# negation cannot resurrect a path whose PARENT directory is excluded.
# `_staging/` is still matched by the `*` line, so a STAGED (unpromoted)
# record stays local — only promoted evidence is tracked.
.canon/ledger/*
!.canon/ledger/kind=evidence_record/
.canon/learn/
.canon/r2/
.canon/ingest/
# Live run manifests written by `canon dispatch begin`/`end` (s8; s40
# added the task/parent binding). One file per dispatched run, local
# runtime state -- never committed, and not yet reconciled into the
# record store (s40 proposal's "does NOT do").
.canon/dispatch/
.canon/REPORT.md
.env
.env.*
!.env.example
.DS_Store
# Python bytecode cache (scripts/ helpers, e.g. the release-safety checker).
__pycache__/
*.pyc
# Local-only vendored reference copies; kept on disk, never tracked.
vendors/
# Astro build cache (packages/website).
.astro/
