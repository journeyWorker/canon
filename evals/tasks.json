{
  "schema_version": 1,
  "name": "canon-p0-maintenance",
  "description": "Real Canon maintenance tasks. A pass requires an exercised command, bounded diff, required evidence, and a passing final gate.",
  "grader_result_schema": {
    "type": "object",
    "required": ["task_id", "changed_paths", "tests", "evidence", "gate", "passed"],
    "properties": {
      "task_id": {"type": "string"},
      "changed_paths": {"type": "array", "items": {"type": "string"}},
      "tests": {"type": "object", "required": ["exit_code", "timed_out"]},
      "evidence": {"type": "object", "required": ["required", "present", "checks"]},
      "gate": {"type": "object", "required": ["passed", "failures"]},
      "passed": {"type": "boolean"}
    }
  },
  "tasks": [
    {
      "id": "doc-schema-conflict-run-01",
      "category": "doc-schema-conflict",
      "instructions": "Resolve the documented Run shape versus the generated run schema. Keep the public contract internally consistent, preserve backward-compatible optional fields, and add a focused regression test. Do not silently change an unrelated record.",
      "setup_seed": {"files": [{"path": "conflict.txt", "content": "Run docs mention context_digest; generated schema currently names context_snapshot_digest.\n"}]},
      "expected_contract": {"checks": [{"name": "schema-generated-test", "kind": "command", "command": ["cargo", "test", "-p", "canon-model", "schema"], "exit_code": 0}]},
      "allowed_diff_paths": ["crates/canon-model/src/**", "crates/canon-model/schemas/run.schema.json", "crates/canon-model/tests/**"],
      "forbidden_side_effects": {"paths": ["Cargo.lock", ".github/**", "target/**", "secrets/**"]},
      "grader": {"command": ["cargo", "test", "-p", "canon-model"], "exit_code": 0, "output_schema": {"type": "text", "meaning": "cargo test must actually execute and exit zero"}},
      "required_evidence": [{"path": ".canon/evidence/doc-schema-conflict-run.json", "format": "json", "required_keys": ["status", "files", "commands"]}],
      "gate": {"evidence_path": ".canon/evidence/gate.json", "required_keys": ["status", "checks", "evidence"]}
    },
    {
      "id": "doc-schema-conflict-evidence-02",
      "category": "doc-schema-conflict",
      "instructions": "Align EvidenceRecord documentation and schema for the redaction/provenance fields. The grader must reject missing required provenance rather than treating an empty value as valid.",
      "setup_seed": {"files": [{"path": "conflict.txt", "content": "Evidence docs and schema disagree about source_digest and redaction.\n"}]},
      "expected_contract": {"checks": [{"name": "model-tests", "kind": "command", "command": ["cargo", "test", "-p", "canon-model"], "exit_code": 0}]},
      "allowed_diff_paths": ["crates/canon-model/src/**", "crates/canon-model/schemas/evidence_record.schema.json", "crates/canon-model/tests/**"],
      "forbidden_side_effects": {"paths": ["Cargo.lock", ".github/**", "target/**"]},
      "grader": {"command": ["cargo", "test", "-p", "canon-model"], "exit_code": 0, "output_schema": {"type": "text"}},
