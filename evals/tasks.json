      "required_evidence": [{"path": ".canon/evidence/approval-production.json", "format": "json", "required_keys": ["status", "approval_ref", "run_id", "change_id", "commands"]}],
      "gate": {"evidence_path": ".canon/evidence/gate.json", "required_keys": ["status", "checks", "evidence"]}
    }
  ]
}
